@using notes.Extensions
@using notes.Features.Auth
@using notes.Features.Components.Toast
@inject Config Config
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/shortcuts/shortcuts.css" asp-append-version="true"/>
    @* In the head, so that what the scripts of the page and its components use of it (setButtonDisabled and the like) is there when they run *@
    @* Also in the head, so that the theme is set before anything is painted *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* <link rel="stylesheet" href="~/notes.styles.css" asp-append-version="true"/> *@
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" href="/" key="Home">@Config.Title</a>
            @* Top right: next to the menu button when the menu is collapsed, after the menu otherwise *@
            <button id="theme-toggle" type="button" class="btn btn-sm btn-outline-secondary ms-auto ms-sm-2 me-2 me-sm-0 order-sm-last" key="!+A">
                <i class="fa-solid fa-moon theme-icon-light"></i><i class="fa-solid fa-sun theme-icon-dark"></i>
            </button>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-body" asp-area="" asp-page="/_/About" key="F1">About</a>
                    </li>
                    @if (User.IsInRole(NotesAccess.AdminRole))
                    {
                        <li class="nav-item">
                        <a class="nav-link text-body" href="/_/Hangfire" key="!H">Hangfire</a>
                        </li>
                    }
                </ul>
                <partial name="/Features/Auth/_Account.cshtml"model='new _Account { IsAuthenticated = User.Identity?.IsAuthenticated == true, IsAdmin = User.IsInRole(NotesAccess.AdminRole), UserName = User.Identity?.Name ?? "", ReturnUrl = Context.OriginalPathAndQuery }'/>
            </div>
        </div>
    </nav>
</header>
<partial name="/Features/Components/Toast/_Toasts.cshtml" model="new _Toasts()"/>
@if (User.IsInRole(NotesAccess.AdminRole))
{
    <partial name="/Features/KillSwitch/_KillSwitchModal.cshtml" model="new notes.Features.KillSwitch._KillSwitchModal()"/>
}
@if (SessionNotice.MessageFor(Context) is { } sessionNotice)
{
    <partial name="/Features/Auth/_SessionNotice.cshtml" model='new _SessionNotice { Message = sessionNotice, ReturnUrl = Context.OriginalPathAndQuery }'/>
}
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="container pb-3 small text-secondary">
    <div>Right control to show keyboard shortcuts.</div>
    <div>
        Licensed under <a class="text-secondary" href="https://github.com/Ascyt/notes/blob/main/LICENSE" target="_blank">AGPL-3.0</a>
        • <a class="text-secondary" href="https://github.com/Ascyt/notes" target="_blank">Source code</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/shortcuts/shortcuts.js"asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>