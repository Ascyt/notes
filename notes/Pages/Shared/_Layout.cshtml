@using notes.Extensions
@using notes.Features.Auth
@inject Config Config
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/shortcuts/shortcuts.css" asp-append-version="true"/>
    @* <link rel="stylesheet" href="~/notes.styles.css" asp-append-version="true"/> *@
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" href="/" key="Home">@Config.Title</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/_/About" key="F1">About</a>
                    </li>
                    @if (User.IsInRole(NotesAccess.AdminRole))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/_/Hangfire">Hangfire</a>
                        </li>
                    }
                </ul>
                <partial name="/Features/Auth/_Account.cshtml"model='new _Account { IsAuthenticated = User.Identity?.IsAuthenticated == true, UserName = User.Identity?.Name ?? "", ReturnUrl = Context.OriginalPathAndQuery }'/>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="container pb-3 small text-secondary">
    <div>Right control to show keyboard shortcuts.</div>
    <div>
        Licensed under <a class="text-secondary" href="https://github.com/Ascyt/notes/blob/main/LICENSE" target="_blank">AGPL-3.0</a>
        • <a class="text-secondary" href="https://github.com/Ascyt/notes" target="_blank">Source code</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/shortcuts/shortcuts.js"asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>