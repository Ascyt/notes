@page "{**path}"
@using notes.Pages.Extensions
@model notes.Pages.IndexModel
@inject Config Config
@{
    ViewData["Title"] = Model.VirtualPath.NormalizedWith(Config.Title);
}

@if (Model.Directory is { CanBrowse: false })
{
    <p class="text-muted"><a href="/_/Login">Log in</a> with an administrator account to browse notes.</p>
}
else if (Model.Directory is not null)
{
    <partial name="View/Directory" model="Model.Directory"/>
}
else if (Model.File is not null)
{
    <partial name="View/File" model="Model.File"/>
}
