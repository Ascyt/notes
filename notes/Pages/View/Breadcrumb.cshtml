@model notes.Pages.View.Breadcrumb

<div class="d-flex align-items-center gap-1 mb-3">
    <a href="/" title="Root" class="text-decoration-none d-flex align-items-center"><i class="fa-regular fa-house fa-xs"></i></a>
    <span class="text-secondary opacity-50">/</span>
    @foreach ((string name, string virtualPath) in Model.Parents)
    {
        <a class="text-decoration-none" href="/@virtualPath">@name</a>
        <span class="text-secondary opacity-50">/</span>
    }
    @if (!Model.IsRoot)
    {
        <i class="fa-regular fa-s @(Model.IsFile ? "fa-file" : "fa-folder")"></i>
        <partial name="View/RenameInput" model="new RenameInput { Name = Model.Name }"/>
    }
</div>
