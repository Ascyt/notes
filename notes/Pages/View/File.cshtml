@model notes.Pages.View.File

<p>Current File: /@Model.VirtualPath</p>

<div id="editor" style="height: 75vh; border: 1px solid #ccc;"></div>

<script src="~/lib/monaco-editor/min/vs/loader.js"></script>
<script>
    require.config({ paths: { vs: '@Url.Content("~/lib/monaco-editor/min/vs")' } });

    require(['vs/editor/editor.main'], function () {
        window.editor = monaco.editor.create(document.getElementById('editor'), {
            value: @Json.Serialize(Model.Contents),
            language: @Json.Serialize(Model.Language),
            theme: 'vs',
            readonly: false,
            automaticLayout: true
        });
    });
</script>
