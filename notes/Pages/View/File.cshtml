@model notes.Pages.View.File

<partial name="View/Breadcrumb" model="new Breadcrumb { IsFile = true, VirtualPath = Model.VirtualPath }"/>

@Html.AntiForgeryToken()
<div id="editor" style="height: 75vh; border: 1px solid #ccc;" key="Enter"></div>
<div class="mt-2">
    <button id="save-button" type="button" class="btn btn-primary" style="display: none;" onclick="saveFile()" key="^S">
        <i class="fa-solid fa-floppy-disk"></i> Save
    </button>
    <span id="save-loading" class="spinner-border spinner-border-sm text-secondary" style="display: none;" aria-hidden="true"></span>
    <partial name="View/DeleteButton" model='new notes.Pages.View.DeleteButton { NeedsConfirmation = false, Kind = "file" }'/>
</div>

<script>
    // Monaco's loader defines a global AMD `define`, which makes the Bootstrap bundle register as a module
    // instead of setting window.bootstrap. Load it only once all page scripts (incl. Bootstrap) have run.
    document.addEventListener('DOMContentLoaded', function () {
        const loader = document.createElement('script');
        loader.src = '@Url.Content("~/lib/monaco-editor/min/vs/loader.js")';
        loader.onload = initEditor;
        document.head.appendChild(loader);
    });

    function initEditor() {
        require.config({ paths: { vs: '@Url.Content("~/lib/monaco-editor/min/vs")' } });

        require(['vs/editor/editor.main'], function () {
            window.editor = monaco.editor.create(document.getElementById('editor'), {
                value: @Json.Serialize(Model.Contents),
                language: @Json.Serialize(Model.Language),
                theme: 'vs',
                readonly: false,
                automaticLayout: true
            });

            savedVersionId = window.editor.getModel().getAlternativeVersionId();
            window.editor.onDidChangeModelContent(updateDirty);

            // Escape leaves the editor, unless Monaco needs it to close a widget or drop extra cursors
            window.editor.addCommand(monaco.KeyCode.Escape, function () {
                document.activeElement.blur();
            }, '!findWidgetVisible && !suggestWidgetVisible && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !hasMultipleSelections && !editorHasSelection');

            window.editor.focus();
        });
    }

    // The editor's key shortcut (see shortcuts.js) focuses it
    document.getElementById('editor').addEventListener('shortcut', function (e) {
        e.preventDefault();
        if (window.editor)
            window.editor.focus();
    });

    let savedVersionId = null;
    let isDirty = false;
    let isSaving = false;

    function updateDirty() {
        isDirty = window.editor.getModel().getAlternativeVersionId() !== savedVersionId;
        document.getElementById('save-button').style.display = isDirty ? '' : 'none';
    }

    function setSaving(saving) {
        isSaving = saving;
        document.getElementById('save-loading').style.display = saving ? '' : 'none';
        if (saving)
            document.getElementById('save-button').style.display = 'none';
    }

    async function saveFile() {
        if (!window.editor || isSaving)
            return;

        setSaving(true);
        
        const versionId = window.editor.getModel().getAlternativeVersionId();
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let response;
        try {
            response = await fetch(window.location.pathname, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'text/plain; charset=utf-8' },
                body: window.editor.getValue()
            });
        } catch {
            response = { ok: false, status: 'network error' };
        } finally {
            setSaving(false);
        }
        if (!response.ok) {
            alert('Failed to save file (' + response.status + ').');
            return;
        }
        savedVersionId = versionId;
        updateDirty();
    }

    // Deleting needs confirmation unless the file is empty and has no unsaved changes
    window.needsDeleteConfirmation = () => !window.editor || isDirty || window.editor.getValue() !== '';
    window.onEntryDeleted = () => { isDirty = false; };
    window.beforeRename = () => {
        if (isDirty || isSaving) {
            alert('The file has unsaved changes. Save it before renaming.');
            return false;
        }
    };

    // Built-in browser prompt when leaving with unsaved changes
    window.addEventListener('beforeunload', function (e) {
        if (isDirty)
            e.preventDefault();
    });
</script>
