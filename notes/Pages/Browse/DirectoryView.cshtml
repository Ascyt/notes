@using notes.Features.Components.Breadcrumb
@using notes.Features.Components.Create
@using notes.Features.Components.Delete
@using notes.Features.Components.Selection
@using notes.Features.Components.Toolbar
@using notes.Features.Components.Upload
@using notes.Pages.Browse
@model notes.Pages.Browse.DirectoryView

<style>
    /* Position of an entry in the listing, shown left of its icon */
    .entry-index {
        display: inline-block;
        min-width: 2ch;
        margin-right: 0.5rem;
        text-align: right;
        font-size: 0.75em;
        opacity: 0.5;
    }

    /* Selection boxes, in the rows and above them */
    .entry-select, .entry-select-all {
        margin-top: 0; /* Bootstrap's own offset (for checkboxes next to a label) puts it below the text */
        margin-right: 0.5rem;
        vertical-align: middle;
        position: relative;
        top: -2px; /* what is left of "middle" being the middle of the lowercase letters, not of the line */
        cursor: pointer;
    }
</style>

@{
    // Whoever can't change anything isn't offered the buttons that do (create, upload, delete), instead of seeing them disabled
    List<ToolbarButton> toolbarButtons = [ToolbarButton.Download(isFile: false)];
    if (!Model.IsReadOnly)
    {
        toolbarButtons.Add(ToolbarButton.Upload(Model.CreateDeniedReason));
        toolbarButtons.Add(ToolbarButton.Delete("directory", Model.DeleteDeniedReason));
    }
    // The leftmost of them, but only there for those who manage permissions
    if (Model.CanConfigure)
        toolbarButtons.Insert(0, ToolbarButton.Permissions("directory"));
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb { IsFile = false, VirtualPath = Model.VirtualPath, RenameDisabledReason = Model.RenameDeniedReason }"/>
<partial name="/Features/Components/Toolbar/_Toolbar.cshtml" model="new _Toolbar { Buttons = toolbarButtons }"/>

<div>
    <table class="table">
        <thead>
        <tr>
            <th class="fw-normal small text-secondary">
                @if (Model.CanSelect)
                {
                    <input type="checkbox" class="form-check-input entry-select-all" data-group="directories" key="a" aria-label="Select all directories"/>
                }Directories
            </th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Directories.Length == 0)
        {
            <tr data-empty-group="directories"><td class="small text-secondary">No subdirectories</td></tr>
        }
        @for (int i = 0; i < Model.Directories.Length; i++)
        {
            @* The row can be selected by clicking anywhere on it but the link; Ctrl plus the shortcut of its link selects it as well *@
            string path = Model.Directories[i].Path;
            string virtualPath = Model.ToVirtualPath(path);
            if (!Model.Directories[i].CanOpen)
            {
                <partial name="/Pages/Browse/_LockedEntry.cshtml" model="new _LockedEntry { Name = System.IO.Path.GetFileName(path), IsDirectory = true, Number = i + 1 }"/>
                continue;
            }
            <tr class="entry-row @(Model.IsSelected(virtualPath) ? "table-active" : "")" data-group="directories" data-path="@virtualPath">
                <td>@if (Model.CanSelect){<input type="checkbox" class="form-check-input entry-select" key="@DirectoryView.NumberKey(i, "^")" aria-label="Select @System.IO.Path.GetFileName(path)" checked="@Model.IsSelected(virtualPath)"/>}<span class="entry-index">@(i + 1)</span><i class="fa-regular fa-folder"></i> <a class="text-decoration-none" href="/@virtualPath" key="@DirectoryView.NumberKey(i, "")" key-anchor="i">@System.IO.Path.GetFileName(path)</a></td>
            </tr>
        }
        @if (!Model.IsReadOnly)
        {
            <tr>
                <td class="border-bottom-0">
                    <partial name="/Features/Components/Create/_CreateButton.cshtml" model="new _CreateButton { IsFile = false, DisabledReason = Model.CreateDeniedReason }"/>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @* No margin below the last table: the page's own padding is all there should be between it and the footer *@
    <table class="table mb-0">
        <thead>
        <tr>
            <th class="fw-normal small text-secondary">
                @if (Model.CanSelect)
                {
                    <input type="checkbox" class="form-check-input entry-select-all" data-group="files" key="+a" aria-label="Select all files"/>
                }Files
            </th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Files.Length == 0)
        {
            <tr data-empty-group="files"><td class="small text-secondary">No files</td></tr>
        }
        @for (int i = 0; i < Model.Files.Length; i++)
        {
            string path = Model.Files[i].Path;
            string virtualPath = Model.ToVirtualPath(path);
            if (!Model.Files[i].CanOpen)
            {
                <partial name="/Pages/Browse/_LockedEntry.cshtml" model="new _LockedEntry { Name = System.IO.Path.GetFileName(path), IsDirectory = false, Number = i + 1 }"/>
                continue;
            }
            <tr class="entry-row @(Model.IsSelected(virtualPath) ? "table-active" : "")" data-group="files" data-path="@virtualPath">
                <td>@if (Model.CanSelect){<input type="checkbox" class="form-check-input entry-select" key="@DirectoryView.NumberKey(i, "^+")" aria-label="Select @System.IO.Path.GetFileName(path)" checked="@Model.IsSelected(virtualPath)"/>}<span class="entry-index">@(i + 1)</span><i class="fa-regular fa-file"></i> <a class="text-decoration-none" href="/@virtualPath" key="@DirectoryView.NumberKey(i, "+")" key-anchor="i">@System.IO.Path.GetFileName(path)</a></td>
            </tr>
        }
        @if (!Model.IsReadOnly)
        {
            <tr>
                <td class="border-bottom-0">
                    <partial name="/Features/Components/Create/_CreateButton.cshtml" model="new _CreateButton { IsFile = true, DisabledReason = Model.CreateDeniedReason }"/>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.IsRoot && !Model.IsReadOnly)
    {
        <partial name="/Features/Components/Delete/_DeleteButton.cshtml" model='new _DeleteButton { NeedsConfirmation = Model.Directories.Length + Model.Files.Length > 0, Kind = "directory" }'/>
    }
</div>

@if (!Model.IsReadOnly)
{
    <partial name="/Features/Components/Upload/_Upload.cshtml" model="new _Upload { DisabledReason = Model.CreateDeniedReason }"/>
}

@* Selecting is for copying, moving and deleting, which need an account: without one there is nothing to select for *@
@if (Model.CanSelect)
{
    <partial name="/Features/Components/Selection/_SelectionBar.cshtml" model="new _SelectionBar { DirectoryPath = Model.CanonicalVirtualPath, Selection = Model.Selection, CreateDeniedReason = Model.CreateDeniedReason }"/>
}
