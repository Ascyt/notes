@using notes.Features.Components.Breadcrumb
@using notes.Features.Components.Create
@using notes.Features.Components.Selection
@using notes.Features.Components.Toolbar
@using notes.Features.Components.Upload
@using notes.Features.HistoryViewing.Changes
@using notes.Features.HistoryViewing.Commits
@using notes.Features.HistoryViewing.Views
@using notes.Pages.Browse
@model notes.Pages.Browse.DirectoryView

<style>
    /* Position of an entry in the listing, shown left of its icon */
    .entry-index {
        display: inline-block;
        min-width: 2ch;
        margin-right: 0.5rem;
        text-align: right;
        font-size: 0.75em;
        opacity: 0.5;
    }

    /* The lines separate rows, so there is none below the last one (whether that is an entry or the + button) */
    .entry-table > tbody > tr:last-child > td {
        border-bottom-width: 0;
    }

    /* The media: a grid of pictures (or icons, for audio), each with its number and name below it. The header is like those of the tables above. */
    .media-group-header {
        padding: 0.5rem;
        border-bottom: var(--bs-border-width) solid var(--bs-border-color);
        cursor: default;
    }

    .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
        gap: 0.5rem;
        padding: 0.5rem 0;
    }

    .media-tile {
        position: relative;
        padding: 0.25rem;
        border-radius: 0.375rem;
        min-width: 0; /* so that a long name is cut off instead of widening the column */
    }

    /* Selected, like a row of the tables (the selection script sets the same class) */
    .media-tile.table-active {
        background: var(--bs-secondary-bg);
    }

    .media-link {
        display: block;
    }

    /* The name is the link, in its color like those of the other entries; the number stays as it is in the rows */
    .media-link .entry-index {
        color: var(--bs-body-color);
    }

    .media-picture {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 0.25rem;
        background: var(--bs-tertiary-bg);
    }

    /* Over the icon, which shows until the picture is there */
    .media-picture img, .media-picture video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none; /* the click is the link's */
    }

    .media-placeholder {
        font-size: 2rem;
        color: var(--bs-secondary-color);
    }

    /* Tells a video from an image at a glance */
    .media-video-mark {
        position: absolute;
        right: 0.375rem;
        bottom: 0.375rem;
        padding: 0.25rem 0.3rem;
        border-radius: 0.25rem;
        font-size: 0.625rem;
        color: #fff;
        background: rgba(0, 0, 0, 0.6);
    }

    .media-caption {
        display: flex;
        align-items: baseline;
        margin-top: 0.25rem;
        white-space: nowrap;
    }

    .media-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .media-link:hover .media-name, .media-link:focus-visible .media-name {
        text-decoration: underline;
    }

    /* Over the corner of the picture, where it doesn't cover what it shows */
    .media-select {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        margin: 0;
        cursor: pointer;
    }

    /* Selection boxes, in the rows and above them */
    .entry-select:not(.media-select), .entry-select-all {
        margin-top: 0; /* Bootstrap's own offset (for checkboxes next to a label) puts it below the text */
        margin-right: 0.5rem;
        vertical-align: middle;
        position: relative;
        top: -2px; /* what is left of "middle" being the middle of the lowercase letters, not of the line */
        cursor: pointer;
    }
</style>

@{
    // Whoever can't change anything isn't offered the buttons that do (create, upload), instead of seeing them disabled
    // The configuration leftmost (only there for those who manage it), then the history (its changes, then the choice of a time), then what moves files in and out
    List<ToolbarButton> toolbarButtons = [];
    if (Model.CanConfigure)
        toolbarButtons.Add(ToolbarButton.Config("directory"));
    if (Model.HistoryButton.IsShown)
    {
        toolbarButtons.Add(ToolbarButton.Commits(Model.HistoryButton.DisabledReason));
        if (Model.CommitChangesButton is { } commitChanges)
            toolbarButtons.Add(commitChanges);
        toolbarButtons.Add(ToolbarButton.History(Model.HistoryButton.DisabledReason));
    }
    // The changes of a commit are no state of the directory that could be downloaded
    if (!Model.ShowsChanges)
        toolbarButtons.Add(ToolbarButton.Download(isFile: false));
    if (!Model.IsReadOnly)
        toolbarButtons.Add(ToolbarButton.Upload(Model.CreateDeniedReason));
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb { IsFile = false, VirtualPath = Model.VirtualPath, RenameDisabledReason = Model.RenameDeniedReason, ParentsWithoutHistory = Model.ParentsWithoutHistory }"/>
<partial name="/Features/Components/Toolbar/_Toolbar.cshtml" model="new _Toolbar { Buttons = toolbarButtons }"/>
@if (Model.HistoryButton.CanBeUsed)
{
    <partial name="/Features/HistoryViewing/Views/_HistoryModal.cshtml" model='new _HistoryModal { Kind = "directory" }'/>
    <partial name="/Features/HistoryViewing/Commits/_CommitSidebar.cshtml" model='Model.CommitSidebar ?? new _CommitSidebar { Kind = "directory" }'/>
}

<div>
    @if (!Model.ShowsDirectories && !Model.ShowsFiles && Model.Media.Length == 0)
    {
        <p id="empty-directory" class="small text-secondary fst-italic mb-0">Empty</p>
    }
    @* An empty group is only its + button, saying what it adds, without the header; with nothing to add either, it is left out *@
    @if (Model.ShowsDirectories)
    {
    <table id="directories-group" class="table entry-table @(!Model.ShowsFiles && Model.Media.Length == 0 ? "mb-0" : "")">
        @if (Model.Directories.Length > 0)
        {
        <thead>
        <tr>
            <th class="fw-normal small text-secondary">
                @if (Model.CanSelect)
                {
                    <input type="checkbox" class="form-check-input entry-select-all" data-group="directories" key="a" aria-label="Select all directories"/>
                }Directories
            </th>
        </tr>
        </thead>
        }
        <tbody>
        @for (int i = 0; i < Model.Directories.Length; i++)
        {
            @* The row can be selected by clicking anywhere on it but the link; Ctrl plus the shortcut of its link selects it as well *@
            string path = Model.Directories[i].Path;
            string virtualPath = Model.ToVirtualPath(path);
            if (!Model.Directories[i].CanOpen)
            {
                <partial name="/Pages/Browse/_UnopenableEntry.cshtml" model="Model.UnopenableRow(Model.Directories[i], i, isDirectory: true)"/>
                continue;
            }
            <tr class="entry-row @(Model.IsSelected(virtualPath) ? "table-active" : "")" data-group="directories" data-path="@virtualPath">
                <td>@if (Model.CanSelect){<input type="checkbox" class="form-check-input entry-select" key="@DirectoryView.NumberKey(i, "^")" aria-label="Select @Model.NameOf(path)" checked="@Model.IsSelected(virtualPath)"/>}<span class="entry-index">@DirectoryView.NumberText(i, Model.Directories.Length)</span><i class="fa-solid fa-folder"></i> <a class="@Model.LinkDecoration(Model.Directories[i])" href="@VirtualPaths.ToAddress(virtualPath)" key="@DirectoryView.NumberKey(i, "")" key-anchor="i">@Model.NameOf(path)</a>@if (Model.Directories[i].Mark is { } mark){<partial name="/Features/HistoryViewing/Changes/_ChangeMark.cshtml" model="new _ChangeMark { Mark = mark }"/>}</td>
            </tr>
        }
        @if (!Model.IsReadOnly)
        {
            <tr>
                <td>
                    <partial name="/Features/Components/Create/_CreateButton.cshtml" model="new _CreateButton { IsFile = false, DisabledReason = Model.CreateDeniedReason, ShowsLabel = Model.Directories.Length == 0 }"/>
                </td>
            </tr>
        }
        </tbody>
    </table>
    }
    @if (Model.ShowsFiles)
    {
    @* No margin below the last group: the page's own padding is all there should be between it and the footer *@
    <table id="files-group" class="table entry-table @(Model.Media.Length == 0 ? "mb-0" : "")">
        @if (Model.Files.Length > 0)
        {
        <thead>
        <tr>
            <th class="fw-normal small text-secondary">
                @if (Model.CanSelect)
                {
                    <input type="checkbox" class="form-check-input entry-select-all" data-group="files" key="+a" aria-label="Select all files"/>
                }Files
            </th>
        </tr>
        </thead>
        }
        <tbody>
        @for (int i = 0; i < Model.Files.Length; i++)
        {
            string path = Model.Files[i].Path;
            string virtualPath = Model.ToVirtualPath(path);
            if (!Model.Files[i].CanOpen)
            {
                <partial name="/Pages/Browse/_UnopenableEntry.cshtml" model="Model.UnopenableRow(Model.Files[i], i, isDirectory: false)"/>
                continue;
            }
            <tr class="entry-row @(Model.IsSelected(virtualPath) ? "table-active" : "")" data-group="files" data-path="@virtualPath">
                <td>@if (Model.CanSelect){<input type="checkbox" class="form-check-input entry-select" key="@DirectoryView.NumberKey(i, "^+")" aria-label="Select @Model.NameOf(path)" checked="@Model.IsSelected(virtualPath)"/>}<span class="entry-index">@DirectoryView.NumberText(i, Model.Files.Length)</span><i class="fa-regular fa-file"></i> <a class="@Model.LinkDecoration(Model.Files[i])" href="@VirtualPaths.ToAddress(virtualPath)" key="@DirectoryView.NumberKey(i, "+")" key-anchor="i">@Model.NameOf(path)</a>@if (Model.Files[i].Mark is { } mark){<partial name="/Features/HistoryViewing/Changes/_ChangeMark.cshtml" model="new _ChangeMark { Mark = mark }"/>}</td>
            </tr>
        }
        @if (!Model.IsReadOnly)
        {
            <tr>
                <td>
                    <partial name="/Features/Components/Create/_CreateButton.cshtml" model="new _CreateButton { IsFile = true, DisabledReason = Model.CreateDeniedReason, ShowsLabel = Model.Files.Length == 0 }"/>
                </td>
            </tr>
        }
        </tbody>
    </table>
    }
    @* Images and videos, as pictures in a grid; only there if there are any (new ones are added through the files above, or uploaded) *@
    @if (Model.Media.Length > 0)
    {
        <div id="media-group" class="media-group">
            <div class="media-group-header fw-normal small text-secondary">
                @if (Model.CanSelect)
                {
                    <input type="checkbox" class="form-check-input entry-select-all" data-group="media" key="!a" aria-label="Select all media"/>
                }Media
            </div>
            <div class="media-grid">
                @for (int i = 0; i < Model.Media.Length; i++)
                {
                    <partial name="/Pages/Browse/_MediaTile.cshtml" model="Model.MediaTile(Model.Media[i], i)"/>
                }
            </div>
        </div>
    }
</div>

@if (!Model.IsReadOnly)
{
    <partial name="/Features/Components/Upload/_Upload.cshtml" model="new _Upload { DisabledReason = Model.CreateDeniedReason }"/>
}

@* Selecting is for copying, moving and deleting, which need an account: without one there is nothing to select for *@
@if (Model.CanSelect)
{
    <partial name="/Features/Components/Selection/_SelectionBar.cshtml" model="new _SelectionBar { DirectoryPath = Model.CanonicalVirtualPath, Selection = Model.Selection, CreateDeniedReason = Model.CreateDeniedReason }"/>
}
