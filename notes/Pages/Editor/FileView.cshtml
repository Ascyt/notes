@using notes.Features.Components.Breadcrumb
@using notes.Features.Components.Delete
@using notes.Features.Components.Toolbar
@model notes.Features.View.Editor.FileView

@{
    // Saving is for what can be edited
    List<ToolbarButton> toolbarButtons = [ToolbarButton.Download(isFile: true), ToolbarButton.Delete("file", Model.DeleteDeniedReason)];
    if (!Model.IsBinary)
        toolbarButtons.Insert(0, ToolbarButton.Save(Model.CanWrite ? null : ReadOnlyReason));
}
@functions {
    private const string ReadOnlyReason = "You may not change this file.";
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb { IsFile = true, VirtualPath = Model.VirtualPath, RenameDisabledReason = Model.RenameDeniedReason }"/>
<partial name="/Features/Components/Toolbar/_Toolbar.cshtml" model="new _Toolbar { Buttons = toolbarButtons }"/>

@if (Model.IsBinary)
{
    <partial name="/Pages/Editor/BinaryView.cshtml" model="Model"/>
    return;
}

@Html.AntiForgeryToken()
<div id="editor" style="height: 75vh; border: 1px solid #ccc;" key="Enter"></div>
<partial name="/Features/Components/Delete/_DeleteButton.cshtml" model='new _DeleteButton { NeedsConfirmation = false, Kind = "file" }'/>

<script>
    // Monaco's loader defines a global AMD `define`, which makes the Bootstrap bundle register as a module
    // instead of setting window.bootstrap. Load it only once all page scripts (incl. Bootstrap) have run.
    document.addEventListener('DOMContentLoaded', function () {
        const loader = document.createElement('script');
        loader.src = '@Url.Content("~/lib/monaco-editor/min/vs/loader.js")';
        loader.onload = initEditor;
        document.head.appendChild(loader);
    });

    function initEditor() {
        require.config({ paths: { vs: '@Url.Content("~/lib/monaco-editor/min/vs")' } });

        require(['vs/editor/editor.main'], function () {
            window.editor = monaco.editor.create(document.getElementById('editor'), {
                value: @Json.Serialize(Model.Contents),
                language: @Json.Serialize(Model.Language),
                theme: 'vs',
                readOnly: !canWrite,
                readOnlyMessage: { value: @Json.Serialize(ReadOnlyReason) },
                automaticLayout: true,
                wordWrap: 'on',
                mouseWheelZoom: true // Ctrl+scroll zooms the editor
            });

            savedVersionId = window.editor.getModel().getAlternativeVersionId();
            window.editor.onDidChangeModelContent(updateDirty);

            // Escape leaves the editor, unless Monaco needs it to close a widget or drop extra cursors
            window.editor.addCommand(monaco.KeyCode.Escape, function () {
                document.activeElement.blur();
            }, '!findWidgetVisible && !suggestWidgetVisible && !parameterHintsVisible && !inSnippetMode && !renameInputVisible && !hasMultipleSelections && !editorHasSelection');

            // Alt+Z toggles word wrap
            window.editor.addCommand(monaco.KeyMod.Alt | monaco.KeyCode.KeyZ, function () {
                const isOn = window.editor.getOption(monaco.editor.EditorOption.wordWrap) !== 'off';
                window.editor.updateOptions({ wordWrap: isOn ? 'off' : 'on' });
            });

            // Ctrl+Plus / Ctrl+Minus / Ctrl+0 zoom the editor instead of the page while it is focused
            const zoomBindings = [
                ['editor.action.fontZoomIn', [monaco.KeyCode.Equal, monaco.KeyCode.NumpadAdd]],
                ['editor.action.fontZoomOut', [monaco.KeyCode.Minus, monaco.KeyCode.NumpadSubtract]],
                ['editor.action.fontZoomReset', [monaco.KeyCode.Digit0, monaco.KeyCode.Numpad0]]
            ];
            for (const [actionId, keys] of zoomBindings) {
                for (const key of keys) {
                    for (const shift of [0, monaco.KeyMod.Shift]) {
                        window.editor.addCommand(monaco.KeyMod.CtrlCmd | shift | key, function () {
                            window.editor.getAction(actionId).run();
                        });
                    }
                }
            }

            window.editor.focus();
        });
    }

    // The editor's key shortcut (see shortcuts.js) focuses it
    document.getElementById('editor').addEventListener('shortcut', function (e) {
        e.preventDefault();
        if (window.editor)
            window.editor.focus();
    });

    const canWrite = @Json.Serialize(Model.CanWrite); // otherwise the editor is read-only and Save stays disabled
    let savedVersionId = null;
    let isDirty = false;
    let isSaving = false;

    function updateDirty() {
        isDirty = window.editor.getModel().getAlternativeVersionId() !== savedVersionId;
        if (canWrite)
            setButtonDisabled(document.getElementById('save-button'), isDirty ? null : 'There is nothing to save.');
    }

    function setSaving(saving) {
        isSaving = saving;
        setButtonBusy(document.getElementById('save-button'), saving);
    }

    // With nothing to save the Save button (and so its shortcut) does nothing, but the browser's own "save page" is never what is meant
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 's')
            e.preventDefault();
    });

    async function saveFile() {
        if (!window.editor || isSaving)
            return;

        setSaving(true);
        
        const versionId = window.editor.getModel().getAlternativeVersionId();
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let response;
        try {
            response = await fetch(window.location.pathname, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'text/plain; charset=utf-8' },
                body: window.editor.getValue()
            });
        } catch {
            response = { ok: false, status: 'network error' };
        } finally {
            setSaving(false);
        }
        if (!response.ok) {
            const message = typeof response.text === 'function' ? await response.text() : '';
            notify(message || ('Failed to save file (' + response.status + ').'), 'danger');
            return;
        }
        savedVersionId = versionId;
        updateDirty();
    }

    // Deleting needs confirmation unless the file is empty and has no unsaved changes
    window.needsDeleteConfirmation = () => !window.editor || isDirty || window.editor.getValue() !== '';
    window.onEntryDeleted = () => { isDirty = false; };
    window.beforeRename = () => {
        if (isDirty || isSaving) {
            notify('The file has unsaved changes. Save it before renaming.', 'warning');
            return false;
        }
    };

    // Built-in browser prompt when leaving with unsaved changes
    window.addEventListener('beforeunload', function (e) {
        if (isDirty)
            e.preventDefault();
    });
</script>
