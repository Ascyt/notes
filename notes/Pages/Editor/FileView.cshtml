@using notes.Features.Components.Breadcrumb
@using notes.Features.Components.Delete
@using notes.Features.Components.Toolbar
@using notes.Features.HistoryViewing.Commits
@using notes.Features.HistoryViewing.Views
@using notes.Pages.Editor
@model notes.Pages.Editor.FileView

@{
    // Whoever can't change anything about the file isn't offered the buttons that do (save, delete), instead of seeing them disabled.
    // Instead of edit they get the way to the source, which the editor shows read-only.
    List<ToolbarButton> toolbarButtons = [];
    bool isEditing = !Model.IsBinary && !Model.ShowsPreview;
    // Save is for what can be edited. Next to it the way between the two views of a markdown file: the other view is what the button leads to.
    if (isEditing && !Model.IsReadOnly)
        toolbarButtons.Add(ToolbarButton.Save(Model.CanWrite ? null : Model.ReadOnlyReason));
    if (Model.IsMarkdown)
    {
        if (isEditing)
            toolbarButtons.Add(ToolbarButton.Preview());
        else
            toolbarButtons.Add(Model.CanWrite ? ToolbarButton.Edit() : ToolbarButton.ViewSource());
    }
    if (isEditing)
    {
        toolbarButtons.Add(ToolbarButton.SimpleView());
        toolbarButtons.Add(ToolbarButton.ZoomOut());
        toolbarButtons.Add(ToolbarButton.ZoomIn());
    }
    // The configuration (only there for those who manage it), then the history (its changes, then the choice of a time), left of the other views and the download
    if (Model.CanConfigure)
        toolbarButtons.Add(ToolbarButton.Config("file"));
    if (Model.HistoryButton.IsShown)
    {
        toolbarButtons.Add(ToolbarButton.Commits(Model.HistoryButton.DisabledReason));
        if (Model.CommitChangesButton is { } commitChanges)
            toolbarButtons.Add(commitChanges);
        toolbarButtons.Add(ToolbarButton.History(Model.HistoryButton.DisabledReason));
    }
    // Only what the browser can show has raw bytes to look at (see RawHandler)
    if (Model.IsBinary && Model.Media != MediaKind.None)
        toolbarButtons.Add(ToolbarButton.Raw());
    if (Model.ShowsPreview)
        toolbarButtons.Add(ToolbarButton.SaveAsPdf());
    toolbarButtons.Add(ToolbarButton.Download(isFile: true));
    if (!Model.IsReadOnly)
        toolbarButtons.Add(ToolbarButton.Delete("file", Model.DeleteDeniedReason));
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb { IsFile = true, VirtualPath = Model.VirtualPath, RenameDisabledReason = Model.RenameDeniedReason, ParentsWithoutHistory = Model.ParentsWithoutHistory }"/>
<partial name="/Features/Components/Toolbar/_Toolbar.cshtml" model="new _Toolbar { Buttons = toolbarButtons }"/>
@if (Model.HistoryButton.CanBeUsed)
{
    <partial name="/Features/HistoryViewing/Views/_HistoryModal.cshtml" model='new _HistoryModal { Kind = "file" }'/>
    <partial name="/Features/HistoryViewing/Commits/_CommitSidebar.cshtml" model='Model.CommitSidebar ?? new _CommitSidebar { Kind = "file" }'/>
}

@if (Model.IsBinary)
{
    <partial name="/Pages/Editor/BinaryView.cshtml" model="Model"/>
    return;
}

@if (Model.ShowsPreview)
{
    @* What the markdown looks like. The HTML is made by MarkdownRenderer, which leaves nothing in it that could run a script. *@
    <link rel="stylesheet" href="~/css/markdown.css" asp-append-version="true"/>
    @* Unlike the rest of the page, the text is kept to Bootstrap's container widths: long lines over the whole screen are hard to read.
       No padding of its own, as the page's container already has it. *@
    <div class="markdown-frame">
        <div class="container px-0 position-relative">
            <article id="markdown-preview" class="markdown-body markdown-edit-gutter">
                @if (Model.Contents.Length == 0)
                {
                    <p id="empty-file" class="text-muted">This file is empty.</p>
                }
                else
                {
                    @Html.Raw(Model.Preview.Html)
                }
            </article>
            @* Next to the part of the text that is pointed at or tapped: opens the editor where that part is written (markdown-edit-here.js),
               read-only for whoever can't change the file *@
            @if (Model.CanWrite)
            {
                <a id="edit-here-button" class="markdown-edit-here text-body" href="?edit" aria-label="Edit here" title="Edit here" hidden>
                    <i class="fa-solid fa-pencil"></i>
                </a>
            }
            else
            {
                <a id="view-source-here-button" class="markdown-edit-here text-body" href="?edit" aria-label="View the source here" title="View the source here" hidden>
                    <i class="fa-regular fa-file-code"></i>
                </a>
            }
        </div>
    </div>
    @* The scripts that render math and diagrams are large, so they are only loaded for a file that has some (and markdown.js only
       for a file that has anything for it to do) *@
    @if (Model.Preview.HasMath)
    {
        <link rel="stylesheet" href="~/lib/katex/dist/katex.min.css"/>
        <script src="~/lib/katex/dist/katex.min.js"></script>
    }
    @if (Model.Preview.HasDiagrams)
    {
        <script src="~/lib/mermaid/dist/mermaid.min.js"></script>
    }
    @if (Model.Preview.HasMath || Model.Preview.HasDiagrams || Model.Preview.HasAbbreviations)
    {
        <script src="~/js/markdown/markdown.js" asp-append-version="true"></script>
    }
    <script src="~/js/markdown/markdown-print.js" asp-append-version="true"></script>
    <script src="~/js/markdown/markdown-edit-here.js" asp-append-version="true"></script>
    @if (!Model.IsReadOnly)
    {
        <partial name="/Features/Components/Delete/_DeleteButton.cshtml" model='new _DeleteButton { NeedsConfirmation = Model.Contents.Length != 0, Kind = "file" }'/>
    }
    return;
}

@Html.AntiForgeryToken()
<style>
    #editor {
        height: 75vh;
        border: 1px solid var(--bs-border-color);
    }

    /* Where the focus is, at a glance */
    #editor:focus-within {
        border-color: var(--bs-primary);
    }
</style>
<div id="editor" key="Enter"></div>
@* The simple view: a plain text field, for phones, where Monaco is awkward to use. Only one of the two is shown. *@
<textarea id="simple-editor" class="form-control font-monospace" style="height: 75vh; resize: none; font-size: 1rem;" spellcheck="false" key="Enter" aria-label="File contents" hidden></textarea>
@if (!Model.IsReadOnly)
{
    <partial name="/Features/Components/Delete/_DeleteButton.cshtml" model='new _DeleteButton { NeedsConfirmation = false, Kind = "file" }'/>
}

@* What the script knows about the file. Serialized with < and > escaped, so the contents can't end the script element. *@
<script type="application/json" id="file-editor-options">@(Json.Serialize(new FileEditorOptions(
    CanWrite: Model.CanWrite,
    Contents: Model.Contents,
    Language: Model.Language,
    MonacoPath: Url.Content("~/lib/monaco-editor/min/vs"),
    ReadOnlyMessage: Model.ReadOnlyReason)))</script>
<script src="~/js/editor/editor.js" asp-append-version="true"></script>
<script src="~/js/editor/editor-start-position.js" asp-append-version="true"></script>
<script src="~/js/editor/file-editor.js" asp-append-version="true"></script>
