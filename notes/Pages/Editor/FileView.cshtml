@using notes.Features.Components.Breadcrumb
@using notes.Features.Components.Delete
@using notes.Features.Components.Toolbar
@using notes.Features.View.Editor
@model notes.Features.View.Editor.FileView

@{
    // Whoever can't change anything about the file isn't offered the buttons that do (save, edit, delete), instead of seeing them disabled
    List<ToolbarButton> toolbarButtons = [];
    bool isEditing = !Model.IsBinary && !Model.ShowsPreview;
    // Save is for what can be edited. Next to it the way between the two views of a markdown file: the other view is what the button leads to.
    if (isEditing && !Model.IsReadOnly)
        toolbarButtons.Add(ToolbarButton.Save(Model.CanWrite ? null : ReadOnlyReason));
    if (Model.IsMarkdown)
    {
        if (isEditing)
            toolbarButtons.Add(ToolbarButton.Preview());
        else if (Model.CanWrite)
            toolbarButtons.Add(ToolbarButton.Edit());
    }
    if (isEditing)
        toolbarButtons.Add(ToolbarButton.SimpleView());
    if (Model.CanConfigure)
        toolbarButtons.Add(ToolbarButton.Permissions("file"));
    // Only what the browser can show has raw bytes to look at (see RawHandler)
    if (Model.IsBinary && Model.Media != MediaKind.None)
        toolbarButtons.Add(ToolbarButton.Raw());
    toolbarButtons.Add(ToolbarButton.Download(isFile: true));
    if (!Model.IsReadOnly)
        toolbarButtons.Add(ToolbarButton.Delete("file", Model.DeleteDeniedReason));
}
@functions {
    private const string ReadOnlyReason = "Insufficient permissions to change this file.";
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb { IsFile = true, VirtualPath = Model.VirtualPath, RenameDisabledReason = Model.RenameDeniedReason }"/>
<partial name="/Features/Components/Toolbar/_Toolbar.cshtml" model="new _Toolbar { Buttons = toolbarButtons }"/>

@if (Model.IsBinary)
{
    <partial name="/Pages/Editor/BinaryView.cshtml" model="Model"/>
    return;
}

@if (Model.ShowsPreview)
{
    @* What the markdown looks like. The HTML is made by MarkdownRenderer, which leaves nothing in it that could run a script. *@
    <link rel="stylesheet" href="~/css/markdown.css" asp-append-version="true"/>
    @* Unlike the rest of the page, the text is kept to Bootstrap's container widths: long lines over the whole screen are hard to read.
       No padding of its own, as the page's container already has it. *@
    <div class="container px-0">
        <article id="markdown-preview" class="markdown-body">
            @if (Model.Contents.Length == 0)
            {
                <p id="empty-file" class="text-muted">This file is empty.</p>
            }
            else
            {
                @Html.Raw(Model.Preview.Html)
            }
        </article>
    </div>
    @* The scripts that render math and diagrams are large, so they are only loaded for a file that has some (and markdown.js only
       for a file that has anything for it to do) *@
    @if (Model.Preview.HasMath)
    {
        <link rel="stylesheet" href="~/lib/katex/dist/katex.min.css"/>
        <script src="~/lib/katex/dist/katex.min.js"></script>
    }
    @if (Model.Preview.HasDiagrams)
    {
        <script src="~/lib/mermaid/dist/mermaid.min.js"></script>
    }
    @if (Model.Preview.HasMath || Model.Preview.HasDiagrams || Model.Preview.HasAbbreviations)
    {
        <script src="~/js/markdown.js" asp-append-version="true"></script>
    }
    @if (!Model.IsReadOnly)
    {
        <partial name="/Features/Components/Delete/_DeleteButton.cshtml" model='new _DeleteButton { NeedsConfirmation = Model.Contents.Length != 0, Kind = "file" }'/>
    }
    return;
}

@Html.AntiForgeryToken()
<div id="editor" style="height: 75vh; border: 1px solid var(--bs-border-color);" key="Enter"></div>
@* The simple view: a plain text field, for phones, where Monaco is awkward to use. Only one of the two is shown. *@
<textarea id="simple-editor" class="form-control font-monospace" style="height: 75vh; resize: none; font-size: 1rem;" spellcheck="false" key="Enter" aria-label="File contents" hidden></textarea>
@if (!Model.IsReadOnly)
{
    <partial name="/Features/Components/Delete/_DeleteButton.cshtml" model='new _DeleteButton { NeedsConfirmation = false, Kind = "file" }'/>
}

<script src="~/js/editor.js" asp-append-version="true"></script>
<script>
    const SIMPLE_VIEW_KEY = 'notes.simpleEditor';
    const canWrite = @Json.Serialize(Model.CanWrite); // otherwise the editor is read-only and Save stays disabled
    const monacoElement = document.getElementById('editor');
    const simpleElement = document.getElementById('simple-editor');
    const viewButton = document.getElementById('simple-view-button');
    const normalize = text => text.replace(/\r\n?/g, '\n');

    let monacoEditor = null;  // only there once Monaco has loaded, which it does only when it is shown (it is a lot to load on a phone)
    let monacoLoading = null;
    let useSimple = readSimpleView();
    let savedValue = normalize(@Json.Serialize(Model.Contents)); // what the file is, as far as this page knows (line breaks as \n, as in the text field)
    let isDirty = false;
    let isSaving = false;

    simpleElement.value = @Json.Serialize(Model.Contents);
    simpleElement.readOnly = !canWrite;

    // localStorage can throw (blocked storage, private mode), and then the choice just isn't kept
    function readSimpleView() {
        try {
            return localStorage.getItem(SIMPLE_VIEW_KEY) === 'true';
        } catch {
            return false;
        }
    }

    function writeSimpleView(simple) {
        try {
            localStorage.setItem(SIMPLE_VIEW_KEY, String(simple));
        } catch {
        }
    }

    // The contents of whichever view is shown
    function currentValue() {
        return useSimple || !monacoEditor ? simpleElement.value : monacoEditor.getValue();
    }

    function updateDirty() {
        isDirty = normalize(currentValue()) !== savedValue;
        if (canWrite)
            setButtonDisabled(document.getElementById('save-button'), isDirty ? null : 'There is nothing to save.');
    }

    function setSaving(saving) {
        isSaving = saving;
        setButtonBusy(document.getElementById('save-button'), saving);
    }

    // The editor's key shortcut (see shortcuts.js) focuses it
    monacoElement.addEventListener('shortcut', function (e) {
        e.preventDefault();
        if (monacoEditor)
            monacoEditor.focus();
    });
    simpleElement.addEventListener('shortcut', function (e) {
        e.preventDefault(); // not the default, which would select all of it
        simpleElement.focus();
    });
    simpleElement.addEventListener('input', updateDirty);

    // With nothing to save the Save button (and so its shortcut) does nothing, but the browser's own "save page" is never what is meant
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 's')
            e.preventDefault();
    });

    async function saveFile() {
        if (isSaving || (!useSimple && !monacoEditor))
            return;

        setSaving(true);

        const value = currentValue();
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let response;
        try {
            response = await fetch(window.location.pathname, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'text/plain; charset=utf-8' },
                body: value
            });
        } catch {
            response = { ok: false, status: 'network error' };
        } finally {
            setSaving(false);
        }
        if (!response.ok) {
            const message = typeof response.text === 'function' ? await response.text() : '';
            notify(message || ('Failed to save file (' + response.status + ').'), 'danger');
            return;
        }
        savedValue = normalize(value);
        updateDirty();
    }

    // ---- The two views ----

    async function showMonaco() {
        simpleElement.hidden = true;
        monacoElement.hidden = false;

        if (!monacoLoading)
            monacoLoading = createEditor(monacoElement, {
                basePath: '@Url.Content("~/lib/monaco-editor/min/vs")',
                value: @Json.Serialize(Model.Contents),
                language: @Json.Serialize(Model.Language),
                readOnly: !canWrite,
                readOnlyMessage: @Json.Serialize(ReadOnlyReason)
            }).then(function (editor) {
                monacoEditor = editor;
                window.editor = editor;
                editor.onDidChangeModelContent(updateDirty);
                return editor;
            });

        const editor = await monacoLoading;
        if (useSimple)
            return; // the simple view was chosen again while Monaco loaded

        // What was typed in the simple view meanwhile
        if (normalize(editor.getValue()) !== simpleElement.value)
            editor.setValue(simpleElement.value);
        editor.focus();
    }

    function showSimple() {
        if (monacoEditor)
            simpleElement.value = monacoEditor.getValue();
        monacoElement.hidden = true;
        simpleElement.hidden = false;
    }

    // The button leads to the other view, so its icon is that of the other view
    function updateViewButton() {
        const icon = viewButton.querySelector('.btn-icon');
        icon.classList.remove('fa-solid', 'fa-regular', 'fa-mobile-screen-button', 'fa-keyboard');
        icon.classList.add(...(useSimple ? ['fa-regular', 'fa-keyboard'] : ['fa-solid', 'fa-mobile-screen-button']));
        const label = useSimple ? 'Switch to the code editor' : 'Switch to the simple editor (for phones)';
        viewButton.dataset.label = label;
        viewButton.dataset.leadsTo = useSimple ? 'code' : 'simple';
        viewButton.setAttribute('aria-label', label);
        refreshButton(viewButton);
    }

    function toggleSimpleView() {
        useSimple = !useSimple;
        writeSimpleView(useSimple);
        updateViewButton();
        if (useSimple)
            showSimple();
        else
            showMonaco();
        updateDirty();
    }

    // Deleting needs confirmation unless the file is empty and has no unsaved changes
    window.needsDeleteConfirmation = () => (!useSimple && !monacoEditor) || isDirty || currentValue() !== '';
    window.onEntryDeleted = () => { isDirty = false; };
    window.beforeRename = () => {
        if (isDirty || isSaving) {
            notify('The file has unsaved changes, which have to be saved before renaming.', 'warning');
            return false;
        }
    };

    // Built-in browser prompt when leaving with unsaved changes
    window.addEventListener('beforeunload', function (e) {
        if (isDirty)
            e.preventDefault();
    });

    // Last, as it needs everything above. Monaco is made once it has loaded.
    updateViewButton();
    if (useSimple)
        showSimple();
    else
        showMonaco();
</script>
