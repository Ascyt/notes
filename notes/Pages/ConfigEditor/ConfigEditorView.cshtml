@using notes.Features.Components.Breadcrumb
@using notes.Features.Components.Toolbar
@model notes.Pages.ConfigEditor.ConfigEditorView

@* The configuration of a directory or file (?config), edited as the JSON they are saved as. It is an editor like the one of a file, with
   Save, and a Reset that puts the default into it. What is wrong with the text is told by the server when saving, and by the schema
   while typing. *@

@{
    string kind = Model.IsFile ? "file" : "directory";
    List<ToolbarButton> toolbarButtons =
    [
        ToolbarButton.Save(),
        ToolbarButton.ResetConfig(),
        ToolbarButton.ZoomOut(),
        ToolbarButton.ZoomIn(),
        ToolbarButton.BackToEntry(kind, VirtualPaths.ToAddress(Model.VirtualPath))
    ];
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb { IsFile = Model.IsFile, VirtualPath = Model.VirtualPath, RenameDisabledReason = RenameDisabledReason }"/>
<partial name="/Features/Components/Toolbar/_Toolbar.cshtml" model="new _Toolbar { Buttons = toolbarButtons }"/>
@functions {
    private const string RenameDisabledReason = "Leave the configuration to rename it.";
}

<p class="small text-secondary mb-2">
    @* Only what the configuration is: what each setting means is in the comments of the default (Reset) and in the schema's tooltips *@
    <i class="fa-solid fa-gear"></i> Configuration of this @kind: who may do what with it.
    @if (Model.IsFile)
    {
        <text>This file's entry in the configuration of its folder, without the name.</text>
    }
    else
    {
        <text>Everything in this directory has it as well, unless it says otherwise.</text>
    }
    Admins may always do everything.
</p>

@if (Model.Warning is not null)
{
    <div id="config-warning" class="alert alert-warning small" style="white-space: pre-line" role="alert">@Model.Warning</div>
}
<div id="config-errors" class="alert alert-danger small d-none" style="white-space: pre-line" role="alert"></div>

@Html.AntiForgeryToken()
<div id="editor" style="height: 65vh; border: 1px solid var(--bs-border-color);" key="Enter"></div>
<p id="config-physical-path" class="small text-secondary mt-2 mb-0 text-break"><i class="fa-solid fa-hard-drive"></i> On disk: <code>@Model.PhysicalPath</code></p>

<script src="~/js/editor/editor.js" asp-append-version="true"></script>
<script type="application/json" id="config-editor-options">@Json.Serialize(Model.EditorOptions(Url.Content("~/lib/monaco-editor/min/vs")))</script>
<script src="~/js/editor/config-editor.js" asp-append-version="true"></script>
