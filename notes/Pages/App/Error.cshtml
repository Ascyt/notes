@page "/_/Error"
@model notes.Pages.App.ErrorModel
@{
    ViewData["Title"] = $"{Model.StatusCode} {Model.Reason}";
}

<div class="py-4">
    <p class="display-1 fw-bold mb-0 @(Model.IsServerError ? "text-danger" : "text-secondary")">@Model.StatusCode</p>
    <h1 class="h3">@Model.Reason</h1>
    <p class="lead">@Model.Description</p>

    @if (Model.MayNeedLogin)
    {
        <div class="alert alert-info d-flex gap-3 align-items-start" role="alert">
            <i class="fa-solid fa-circle-info mt-1"></i>
            <div>
                <p class="mb-2">
                    Not logged in. Some files can only be seen after logging in.
                </p>
                <a class="btn btn-sm btn-primary" asp-page="/App/Login" asp-route-returnUrl="@Model.RequestedPath"><i class="fa-solid fa-right-to-bracket"></i> Log in</a>
            </div>
        </div>
    }

    <div class="mt-4">
        <a class="btn btn-outline-secondary" href="/"><i class="fa-solid fa-house"></i> Back to start</a>
        @if (Model.IsServerError)
        {
            <a class="btn btn-outline-secondary" href="@Model.RequestedPath" key="r"><i class="fa-solid fa-rotate-right"></i> Try again</a>
        }
    </div>

    <dl class="row small text-muted mt-5 mb-0">
        <dt class="col-sm-2">Requested</dt>
        <dd class="col-sm-10"><code>@Model.RequestedPath</code></dd>
        <dt class="col-sm-2">Request ID</dt>
        <dd class="col-sm-10"><code>@Model.RequestId</code></dd>
        <dt class="col-sm-2">Time</dt>
        <dd class="col-sm-10">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
    </dl>
</div>
