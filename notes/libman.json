{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "twitter-bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "monaco-editor@0.52.2",
      "destination": "wwwroot/lib/monaco-editor/",
      "files": [
        "min/vs/**"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fortawesome/fontawesome-free@7.3.1",
      "destination": "wwwroot/lib/fontawesome",
      "files": [
        "css/all.min.css",
        "webfonts/fa-solid-900.woff2",
        "webfonts/fa-regular-400.woff2",
        "webfonts/fa-brands-400.woff2"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "katex@0.16.22",
      "destination": "wwwroot/lib/katex",
      "files": [
        "dist/katex.min.css",
        "dist/katex.min.js",
        "dist/fonts/*.woff2"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "mermaid@11.4.1",
      "destination": "wwwroot/lib/mermaid",
      "files": [
        "dist/mermaid.min.js"
      ]
    }
  ]
}