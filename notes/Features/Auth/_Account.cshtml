@model notes.Features.Auth._Account

<ul class="navbar-nav align-items-sm-center gap-sm-2">
    @if (Model.IsAuthenticated)
    {
        @if (Model.IsAdmin)
        {
            <li class="nav-item">
                @* The confirmation is in the layout (_KillSwitchModal) *@
                <button type="button" class="btn btn-sm btn-outline-secondary btn-danger-on-hover" data-bs-toggle="modal" data-bs-target="#kill-switch-modal"
                        title="Kill switch" aria-label="Kill switch" key="^!+Delete">
                    <i class="fa-solid fa-power-off"></i>
                </button>
            </li>
        }
        <li class="nav-item"><span class="navbar-text"><i class="@(Model.IsAdmin ? "fa-solid fa-user-gear" : "fa-regular fa-user")"></i> @Model.UserName</span></li>
        <li class="nav-item">
            <form method="post" asp-page="/App/Logout">
                <button type="submit" class="btn btn-sm btn-outline-secondary" key="!L"><i class="fa-solid fa-right-from-bracket"></i> Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-primary" asp-page="/App/Login" asp-route-returnUrl="@Model.ReturnUrl" key="!L"><i class="fa-solid fa-right-to-bracket"></i> Log in</a>
        </li>
    }
</ul>
