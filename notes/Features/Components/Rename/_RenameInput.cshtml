@model _RenameInput

<div id="rename" class="input-group input-group-sm" style="max-width: 32rem;">
    @Html.AntiForgeryToken()
    @if (Model.DisabledReason is not null)
    {
        <input id="rename-input" type="text" class="form-control" value="@Model.Name" aria-label="Name" readonly title="Rename: @Model.DisabledReason" data-disabled-reason="@Model.DisabledReason" style="cursor: not-allowed;"/>
    }
    else
    {
        <input id="rename-input" type="text" class="form-control" value="@Model.Name" aria-label="Name" autocomplete="off" spellcheck="false" key="F2"/>
    }
    <button id="rename-cancel" type="button" class="btn btn-outline-secondary" style="display: none;" title="Reset" key="Escape">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <button id="rename-confirm" type="button" class="btn btn-success" style="display: none;" title="Rename" key="Enter">
        <i class="fa-solid fa-check"></i>
    </button>
</div>

<script src="~/js/components/rename.js" asp-append-version="true"></script>
