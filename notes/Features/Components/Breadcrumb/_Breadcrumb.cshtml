@using notes.Features.Components.Rename
@model _Breadcrumb

@* The same height everywhere (that of the rename input at the end of it), so that what is below doesn't move when going from the root to a directory *@
@* Stays at the top of the screen as part of the navbar while the page scrolls (site.css) *@
@* Always one line: where the parents don't fit, breadcrumb.js shortens them (a dot each, then "…" for the outer ones), so that the name at the end keeps its room *@
<div class="sticky-breadcrumb breadcrumb-row" style="min-height: calc(1.5 * 0.875rem + 0.5rem + 2px);">
    @if (Model.IsRoot)
    {
        @* Nowhere to go from here, and nothing to rename *@
        <i class="fa-regular fa-house fa-xs"></i>
        <span>root</span>
    }
    else
    {
        string? rootKey = Model.ParentVirtualPath == "" ? "!ArrowUp Backspace" : null;
        @* A directory without history is shown like such an entry of a listing (see _UnopenableEntry): low-emphasis, with a crossed-out
           calendar, and a link to it as it is now (the history card keeps the time on it, and the page says why it can't be seen as it was),
           unless it is gone. Each kind has its own element, as Razor writes a data- attribute even when its value is null. *@
        if (Model.ParentsWithoutHistory.TryGetValue("", out ParentWithoutHistory? rootWithoutHistory))
        {
            <a href="/" title="Root. @rootWithoutHistory.Reason" class="text-secondary text-decoration-none d-flex align-items-center" key="@rootKey" data-no-history-parent=""><i class="fa-regular fa-house fa-xs"></i><i class="fa-solid fa-calendar-xmark fa-xs ms-1" aria-label="@rootWithoutHistory.Reason"></i></a>
        }
        else
        {
            <a href="/" title="Root" class="text-decoration-none d-flex align-items-center" key="@rootKey"><i class="fa-regular fa-house fa-xs"></i></a>
        }
        <span class="text-secondary opacity-50">/</span>
        @* Stands for the outer parents once even their dots don't fit; leads to the innermost of them *@
        <span id="breadcrumb-collapsed" class="breadcrumb-part" hidden>
            <a class="text-decoration-none" href="/" aria-label="Directories above">…</a>
            <span class="text-secondary opacity-50">/</span>
        </span>
        @foreach ((string name, string virtualPath) in Model.Parents)
        {
            string? key = virtualPath == Model.ParentVirtualPath ? "!ArrowUp Backspace" : null;
            @* The name, or in its place a dot (breadcrumb.js), which has the name as its tooltip *@
            <span class="breadcrumb-part breadcrumb-parent" data-name="@name" data-address="@VirtualPaths.ToAddress(virtualPath)">
                @if (!Model.ParentsWithoutHistory.TryGetValue(virtualPath, out ParentWithoutHistory? withoutHistory))
                {
                    <a class="text-decoration-none" href="@VirtualPaths.ToAddress(virtualPath)" key="@key"><span class="breadcrumb-name">@name</span><i class="fa-solid fa-circle breadcrumb-dot" title="@name" aria-label="@name" hidden></i></a>
                }
                else if (withoutHistory.ExistsNow)
                {
                    <a class="text-secondary text-decoration-none" href="@VirtualPaths.ToAddress(virtualPath)" key="@key" title="@withoutHistory.Reason" data-no-history-parent="@virtualPath"><span class="breadcrumb-name">@name<i class="fa-solid fa-calendar-xmark fa-xs ms-1" aria-label="@withoutHistory.Reason"></i></span><i class="fa-solid fa-circle breadcrumb-dot" title="@name" aria-label="@name" hidden></i></a>
                }
                else
                {
                    <span class="text-secondary" title="@withoutHistory.Reason" data-no-history-parent="@virtualPath"><span class="breadcrumb-name">@name<i class="fa-solid fa-calendar-xmark fa-xs ms-1" aria-label="@withoutHistory.Reason"></i></span><i class="fa-solid fa-circle breadcrumb-dot" title="@name" aria-label="@name" hidden></i></span>
                }
                <span class="text-secondary opacity-50">/</span>
            </span>
        }
        <i class="fa-s @Model.Icon"></i>
        <partial name="/Features/Components/Rename/_RenameInput.cshtml"model="new _RenameInput { Name = Model.Name, DisabledReason = Model.RenameDisabledReason }"/>
        <script src="~/js/components/breadcrumb.js" asp-append-version="true"></script>
    }
</div>
