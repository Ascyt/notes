@model _DeleteButton

 @* Deleting the current file or directory: the confirmation and the script behind the Delete button of the toolbar (#delete-button, see ToolbarButton.Delete) *@

@Html.AntiForgeryToken()
<div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-title">Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                The current @Model.Kind will be deleted.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" key="Escape">Cancel</button>
                <button type="button" id="delete-confirm" class="btn btn-danger" onclick="deleteEntry()" key="Enter">
                    <i class="fa-regular fa-trash-can"></i> Delete @Model.Kind
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function requestDelete() {
        const needsConfirmation = typeof window.needsDeleteConfirmation === 'function'
            ? window.needsDeleteConfirmation()
            : @Json.Serialize(Model.NeedsConfirmation);

        if (needsConfirmation)
            bootstrap.Modal.getOrCreateInstance(document.getElementById('delete-modal')).show();
        else
            deleteEntry();
    }

    async function deleteEntry() {
        const button = document.getElementById('delete-button');
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        setButtonBusy(button, true);
        let response;
        try {
            response = await fetch(window.location.pathname, {
                method: 'DELETE',
                headers: { 'RequestVerificationToken': token }
            });
        } catch {
            response = { ok: false, status: 'network error' };
        }
        if (!response.ok) {
            setButtonBusy(button, false);
            // The server says what went wrong (e.g. a permission that is missing)
            const message = typeof response.text === 'function' ? await response.text() : '';
            notify(message || ('Failed to delete (' + response.status + ').'), 'danger');
            return;
        }

        // Don't prompt about unsaved changes of a file that no longer exists
        if (typeof window.onEntryDeleted === 'function')
            window.onEntryDeleted();
        notifyAfterNavigation('Deleted @(Model.Kind).');
        const parent = window.location.pathname.replace(/\/+$/, '').replace(/\/[^\/]*$/, '');
        window.location.href = parent === '' ? '/' : parent;
    }
</script>
