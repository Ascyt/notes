@using notes.Features.HistoryViewing
@model notes.Features.HistoryViewing._EarlierStateCard

@{
    string before = EarlierStateTime.Format(Model.Before);
}

@* Which earlier state the page shows, for as long as it is shown; × leads to the entry as it is now. The script also keeps the time on every
   link of the page that leads to the notes (those of the layout too), so that the state can be browsed like the notes as they are. *@
<div id="history-card" class="floating-card card shadow" style="border-right: 0.25rem solid var(--bs-primary);" data-before="@before">
    <div class="card-body d-flex align-items-center gap-2 py-2 px-3">
        <i class="fa-solid fa-calendar text-primary"></i>
        <span>Shown as it was before <time id="history-card-time" datetime="@before">@before</time></span>
        <a id="history-exit" class="btn-close ms-2" href="@Model.BackToNowHref" data-history-exit aria-label="Back to now" title="Back to now" key="!+N"></a>
    </div>
</div>

<script>
    (function () {
        const BEFORE_PARAMETER = @Json.Serialize(_HistoryModal.BeforeParameter);
        const card = document.getElementById('history-card');
        const before = card.dataset.before;
        document.getElementById('floating-cards').append(card); // last, so the messages that come in are above it

        // The time in the browser's own time zone (the server only knows UTC)
        document.getElementById('history-card-time').textContent = new Date(before).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });

        // Adds the time to a link that leads to a page of the notes. Links within the page (#…), to the app's own pages (/_/…), to other sites,
        // the way back to now and links that have a time already are left as they are.
        function keepTimeOnLink(link) {
            const href = link.getAttribute('href');
            if (!href || href.startsWith('#') || link.hasAttribute('data-history-exit'))
                return;
            const url = new URL(href, window.location.href);
            if (url.origin !== window.location.origin || url.pathname.startsWith('/_/') || url.searchParams.has(BEFORE_PARAMETER))
                return;
            // Appended as it is (not through URLSearchParams), so that "?download" stays "?download" instead of becoming "?download="
            url.search = (url.search ? url.search + '&' : '?') + BEFORE_PARAMETER + '=' + before;
            link.setAttribute('href', url.pathname + url.search + url.hash);
        }

        // Once the whole page is there, also the parts of it that come after the card
        document.addEventListener('DOMContentLoaded', function () {
            for (const link of document.querySelectorAll('a[href]'))
                keepTimeOnLink(link);
        });
    })();
</script>
