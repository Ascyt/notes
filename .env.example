# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Public hostnames (no scheme). Both need a public hostname on the Cloudflare tunnel pointing at http://caddy:80.
NOTES_HOST=notes.example.com
AUTH_HOST=auth.example.com

# Token of the Cloudflare tunnel (Zero Trust > Networks > Tunnels > your tunnel > Docker command)
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Folder on the host that holds the notes. On Linux it must be writable by uid 1654 (the app user in the container).
# NOTES_DIR=./data/notes

# Password of the Postgres database used by Keycloak
KEYCLOAK_DB_PASSWORD=change-me

# Bootstrap admin of the Keycloak admin console (master realm). Only used on first start;
# change it in the console afterwards.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret of the `notes-web` client. Substituted into keycloak/notes-realm.json on import and
# must match Config:Auth:ClientSecret of the app (dotnet user-secrets in development).
NOTES_CLIENT_SECRET=change-me
