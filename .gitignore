# Build results
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/
*.user
*.suo

# JetBrains Rider
.idea/
*.sln.iml

# Client-side libraries restored via LibMan (see src/Notes/libman.json)
**/wwwroot/lib/

# Tools that build the styles and scripts of the components (see src/Notes/package.json), and what they build: the .css and .js next to
# the .scss and .ts of the components
**/node_modules/
src/Notes/Features/**/*.css
src/Notes/Features/**/*.js
src/Notes/Pages/**/*.css
src/Notes/Pages/**/*.js

# Local secrets for docker compose (see .env.example)
.env

# What only this site has for docker compose, such as bridges (see compose.override.example.yaml)
compose.override.yaml

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Notes and other runtime data of the compose stack
data/

# The app's own data in the notes used in development (temporary files, the history)
src/Notes.Host/notes-test/_/

# Marker of the kill switch when running locally (in production it is in the keys volume)
src/Notes.Host/killed
