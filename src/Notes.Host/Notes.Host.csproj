<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The site that runs the notes (the Notes library) as they are, with Keycloak for the logins. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>fcad709b-3201-446a-86cb-c277717ed9f8</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
        <!-- The notes used in development are data, not part of the site -->
        <Content Remove="notes-test\**" />
        <None Remove="notes-test\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Notes\Notes.csproj" />
    </ItemGroup>

</Project>
