@inject PasswordTexts Texts

@* After the name of an entry with a password of its own that is unlocked: gray, as it only tells that the password will be asked for again *@
<i class="fa-solid fa-lock-open fa-xs ms-1 text-secondary" title="@Texts.UnlockedMark" aria-label="@Texts.UnlockedMark" data-unlocked-mark></i>
