@using Notes.Features.Components.Breadcrumb
@model _PasswordPrompt
@inject BreadcrumbStarts BreadcrumbStarts
@inject PasswordTexts Texts

@* The page of a locked entry: the way to its password. The dialog opens by itself (_PasswordModal.js, by #password-prompt). *@
@{
    string isProtected = Texts.IsProtected.Replace("{entry}", Model.Display);
}

<partial name="/Features/Components/Breadcrumb/_Breadcrumb.cshtml" model="new _Breadcrumb
{
    Start = BreadcrumbStarts.Of(Model.Display),
    IsFile = Model.IsFile,
    VirtualPath = Model.Display,
    RenameDisabledReason = isProtected
}"/>

<div id="password-prompt" class="d-flex flex-column align-items-start gap-3 mt-3" data-address="@Model.Address">
    <p class="text-secondary mb-0">
        <i class="fa-solid fa-lock text-warning"></i> @isProtected
    </p>
    <button type="button" id="password-prompt-button" class="btn btn-warning" key="Enter">
        <i class="fa-solid fa-key"></i> @Texts.EnterPassword
    </button>
</div>
