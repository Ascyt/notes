@model _PasswordModal
@inject PasswordTexts Texts

@* The dialog that asks for the password of a locked entry (_PasswordModal.js opens it, for whatever the server says needs one). It stays usable
   while the page is covered (data-above-busy-overlay), as a request that covered it may be what needs the password. *@

@Html.AntiForgeryToken()
<div class="modal" id="password-modal" tabindex="-1" aria-labelledby="password-title" aria-hidden="true" data-above-busy-overlay>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="password-title"><i class="fa-solid fa-lock text-warning"></i> @Texts.Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Texts.Close"></button>
            </div>
            <form id="password-form" class="modal-body d-flex flex-column gap-2" autocomplete="off">
                <p id="password-entry" class="mb-1"></p>
                <label class="form-label mb-0" for="password-input">@Texts.Password</label>
                <div class="input-group">
                    <input type="password" id="password-input" class="form-control" maxlength="@PasswordHashing.MaxLength"
                        autocomplete="current-password" spellcheck="false" aria-describedby="password-error"/>
                    <button type="button" id="password-toggle" class="btn btn-outline-secondary" aria-pressed="false"
                        title="@Texts.ShowPassword" aria-label="@Texts.ShowPassword">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <div id="password-error" class="form-text text-danger" role="alert" hidden></div>
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" key="Escape">@Texts.Cancel</button>
                <button type="button" id="password-confirm" class="btn btn-warning" key="Enter">
                    <i class="fa-solid fa-unlock btn-icon"></i>
                    <span class="spinner-border spinner-border-sm btn-spinner d-none" aria-hidden="true"></span>
                    @Texts.Unlock
                </button>
            </div>
        </div>
    </div>
</div>

<script-texts id="password-texts" texts="@Texts"/>
<script component-asset="@_PasswordModal.Script"></script>
