@using System.Globalization
@model _ArchivedMark
@inject UnzipTexts Texts

@* After the name of an archived folder (where its archive begins), in the listing and the breadcrumb. Zipped: solid and in color, as going
   into it takes a moment (it is unzipped first). Unzipped: gray, as it only tells how it is kept. An encrypted one has a shield in place of
   the zipper (whole when zipped, halved when unzipped); its password lock is a mark of its own. Being zipped (in the listing): the unzipped
   mark with a bar of how far it got (yellow, like the shield, for an encrypted one), which _Unzipping.ts keeps up to date and turns into the mark it ends as. *@
@if (Model.State == ArchiveState.Zipped)
{
    <i class="@Model.IconClasses(zipped: true)" title="@Model.Title(Texts, zipped: true)" aria-label="@Model.Title(Texts, zipped: true)"
        data-archived-mark="zipped" data-encrypted="@(Model.Encrypted ? "true" : "false")"></i>
}
else if (Model.State == ArchiveState.Zipping && Model.Address is not null)
{
    int percent = (int)Math.Round(Model.Progress * 100);
    <span class="archived-zipping" data-archived-mark="zipping" data-zipping-address="@Model.Address"
        data-encrypted="@(Model.Encrypted ? "true" : "false")" title="@Texts.ZippingNow"><i
        class="@Model.IconClasses(zipped: false)"></i><span class="progress archived-zipping-progress ms-2"
        role="progressbar" aria-label="@Texts.ZippingNow" aria-valuemin="0" aria-valuemax="100"
        aria-valuenow="@percent.ToString(CultureInfo.InvariantCulture)"><span class="progress-bar @(Model.Encrypted ? "bg-warning" : "")"
        style="width: @percent.ToString(CultureInfo.InvariantCulture)%"></span></span><span
        class="archived-zipping-detail small text-secondary ms-2" aria-live="polite"></span></span>
}
else
{
    <i class="@Model.IconClasses(zipped: false)" title="@Model.Title(Texts, zipped: false)" aria-label="@Model.Title(Texts, zipped: false)"
        data-archived-mark="unzipped" data-encrypted="@(Model.Encrypted ? "true" : "false")"></i>
}
