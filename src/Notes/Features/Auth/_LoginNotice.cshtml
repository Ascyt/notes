@model _LoginNotice
@inject AuthTexts Texts

@{
    // The text around the link to the login
    string[] around = Texts.NotLoggedIn.Split("{login}");
}

@* Shown to someone who is not logged in on a page of the app: what they see here may be less than what they would see once logged in,
   and changing anything needs it *@
<div id="login-notice" class="alert alert-secondary d-flex align-items-center gap-2 py-2 small" role="note">
    <i class="fa-solid fa-circle-info flex-shrink-0"></i>
    <span>@around[0]<a class="link" asp-page="/App/Login" asp-route-returnUrl="@Model.ReturnUrl">@Texts.LoginLink</a>@(around.Length > 1 ? around[1] : "")</span>
</div>
