@model Notes.Features.Auth._Account
@inject AuthTexts Texts
@inject Notes.Features.Passwords.PasswordTexts PasswordTexts
@inject Notes.Features.ZippedFolders.UnzipTexts UnzipTexts
@inject Notes.Features.Operations.OperationTexts OperationTexts

<ul class="navbar-nav align-items-sm-center gap-sm-2">
    @* Locks everything the browser has unlocked (_PasswordModal.ts). Shown while anything is, also once the dialog unlocks something. *@
    <li class="nav-item" data-lock-item hidden="@(!Model.HasUnlocked)">
        <button type="button" id="lock-button" class="btn btn-sm btn-warning" title="@PasswordTexts.LockAll"
            aria-label="@PasswordTexts.LockAll" key="!L">
            <i class="fa-solid fa-lock"></i>
        </button>
    </li>
    @* Zips every archived folder that is unzipped now (_Unzipping.ts), instead of waiting for them to be idle. Only while there is nothing to
       lock: the lock button goes first, with the same shortcut. *@
    <li class="nav-item" data-zip-item hidden="@(Model.HasUnlocked || !Model.HasZippable)">
        <button type="button" id="zip-button" class="btn btn-sm btn-primary" title="@UnzipTexts.ZipAll" aria-label="@UnzipTexts.ZipAll"
            data-label="@UnzipTexts.ZipAll" key="!L">
            <i class="fa-solid fa-file-zipper btn-icon"></i><span class="spinner-border spinner-border-sm btn-spinner d-none" aria-hidden="true"></span>
        </button>
    </li>
    @if (Model.IsAuthenticated)
    {
        @* The storage operations that run now (_Operations.cshtml): there while any that the user may see does (its script keeps it so) *@
        <li class="nav-item" data-operations-item hidden="@(!Model.HasOperations)">
            <button type="button" id="operations-button" class="btn btn-sm btn-outline-secondary" title="@OperationTexts.Title"
                aria-label="@OperationTexts.Title" key="!O">
                <i class="fa-solid fa-hard-drive"></i>
            </button>
        </li>
        @if (Model.IsAdmin)
        {
            <li class="nav-item">
                @* The confirmation is in the layout (_KillSwitchModal) *@
                <button type="button" class="btn btn-sm btn-outline-secondary btn-danger-on-hover" data-bs-toggle="modal"
                    data-bs-target="#kill-switch-modal" title="@Texts.KillSwitch" aria-label="@Texts.KillSwitch" key="^!+Delete">
                    <i class="fa-solid fa-power-off"></i>
                </button>
            </li>
        }
        <li class="nav-item">
            <span class="navbar-text">
                <i class="@(Model.IsAdmin ? "fa-solid fa-user-gear" : "fa-regular fa-user")"></i> @Model.UserName
            </span>
        </li>
        <li class="nav-item">
            <form method="post" asp-page="/App/Logout">
                <button type="submit" class="btn btn-sm btn-outline-secondary" key="!+L">
                    <i class="fa-solid fa-right-from-bracket"></i> @Texts.LogOut
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-primary" asp-page="/App/Login" asp-route-returnUrl="@Model.ReturnUrl" key="!+L">
                <i class="fa-solid fa-right-to-bracket"></i> @Texts.LogIn
            </a>
        </li>
    }
</ul>
