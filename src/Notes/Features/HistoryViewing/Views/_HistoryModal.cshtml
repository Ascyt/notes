@model Notes.Features.HistoryViewing.Views._HistoryModal
@inject HistoryTexts Texts

@* Choosing an earlier state of the current file or directory: the dialog and the script behind the History button of the toolbar
   (#history-button, see ToolbarButtons.History). The time goes into the address as ?before=, in UTC, so that it means the same
   wherever the address is opened; the field shows it in the browser's own time zone. The times at which the entry can be seen are
   asked for when the dialog opens (?history), as working them out goes through the whole history. *@

<div class="modal" id="history-modal" tabindex="-1" aria-labelledby="history-modal-title" aria-hidden="true" data-kind="@Model.Kind"
     data-before-parameter="@Notes.Features.HistoryViewing.Requests.EarlierStateParameter.Before"
         data-visible-times-parameter="@Notes.Features.HistoryViewing.Views._HistoryModal.VisibleTimesParameter">
    <div class="modal-dialog">
        <form class="modal-content" id="history-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="history-modal-title">@Texts.ViewEarlierState</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Texts.Close"></button>
            </div>
            <div class="modal-body">
                <label for="history-before" class="form-label">@Texts.ShownAsItWasBefore</label>
                <input type="datetime-local" id="history-before" class="form-control" step="1" required aria-describedby="history-problem"/>
                @* Why View can't be used, also where there is no hovering for its tooltip (phones) *@
                <div id="history-problem" class="invalid-feedback"></div>
                <div class="form-text">@Texts.WhatIsShown(Model.Kind == "file")</div>
                <div class="small text-secondary mt-3 mb-1">@Texts.CanBeSeenAsItWas</div>
                <ul id="history-times" class="small text-secondary mb-0 ps-3" aria-live="polite"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" key="Escape">@Texts.Cancel</button>
                <button type="submit" id="history-apply" class="btn btn-primary" key="Enter" data-label="@Texts.ViewThisState">
                    <i class="fa-solid fa-calendar btn-icon"></i> @Texts.View
                </button>
            </div>
        </form>
    </div>
</div>

<script-texts id="history-texts-modal" texts="@Texts"/>
<script component-asset="@_HistoryModal.Script"></script>
