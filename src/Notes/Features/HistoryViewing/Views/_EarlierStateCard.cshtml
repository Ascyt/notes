@using Notes.Features.HistoryViewing.Changes
@using Notes.Features.HistoryViewing.Requests
@model Notes.Features.HistoryViewing.Views._EarlierStateCard
@inject HistoryTexts Texts

@{
    string time = EarlierStateTime.Format(Model.Time);
    string icon = Model.ShowsChanges ? "fa-code-compare" : Model.Shown.IsCommit ? "fa-code-commit" : "fa-calendar";
    string shownAs = Model.ShowsChanges ? Texts.ChangesMadeOn : Model.Shown.IsCommit ? Texts.ShownAsItWasOn : Texts.ShownAsItWasBefore;
}

@* Which earlier state the page shows, for as long as it is shown; × (Escape, where nothing else takes it: a dialog, a field, the list of
   changes while it has the focus) leads to the entry as it is now. For a commit, a second line says what it
   was and who made it. The script also keeps the state (and that the changes of a commit are shown) on every link of the page that leads
   to the entries (those of the layout too), so that the state can be browsed like the entries as they are. *@
<div id="history-card" class="floating-card card shadow"
     data-parameter="@Model.Shown.Name" data-value="@Model.Shown.Value" data-changes="@(Model.ShowsChanges ? "true" : null)"
     data-before-parameter="@EarlierStateParameter.Before" data-commit-parameter="@EarlierStateParameter.Commit"
         data-changes-parameter="@CommitChangesRequests.ChangesParameter">
    <div class="card-body d-flex align-items-center gap-2 py-2 px-3">
        <i class="fa-solid @icon text-primary"></i>
        <div class="history-card-text d-flex flex-column">
            <span>@shownAs <time id="history-card-time" datetime="@time">@time</time></span>
            @if (Model.Commit is { } commit)
            {
                @* (Who made a commit that no user made in the app is said in italics, as it is no name) *@
                <span id="history-card-commit"
                    class="small text-secondary text-truncate">@commit.Description · @if (commit.Author is { } author) { <span>@author</span> } else { <i>@Texts.Automatic</i> }</span>
            }
        </div>
        <a id="history-exit" class="btn-close ms-2" href="@Model.BackToNowHref" data-history-exit aria-label="@Texts.BackToNow" title="@Texts.BackToNow"
            key="Escape"></a>
    </div>
</div>

<script component-asset="@_EarlierStateCard.Script"></script>
