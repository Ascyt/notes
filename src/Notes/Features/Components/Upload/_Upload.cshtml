@model _Upload
@inject UploadTexts Texts

@* Uploading to the current directory: the file picker, the drop target, the progress and the script behind the Upload button of the toolbar
   (#upload-button, see ToolbarButtons.Upload) *@

@Html.AntiForgeryToken()
<input type="file" id="upload-input" multiple hidden data-chunk-size="@Model.ChunkSize" data-upload-denied="@Model.DisabledReason"/>

<div id="upload-drop-overlay" class="upload-drop-overlay" hidden>
    <div class="upload-drop-message"><i class="fa-solid fa-upload"></i> @Texts.DropFiles</div>
</div>

<div class="modal" id="upload-modal" tabindex="-1" aria-labelledby="upload-modal-title" aria-hidden="true" data-bs-backdrop="static"
    data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="upload-modal-title">@Texts.Title</h5>
            </div>
            <div class="modal-body">
                @* Going on with an upload that didn't finish (_Upload.ts): its files have to be picked again *@
                <div id="upload-resume-note" class="alert alert-info d-flex flex-wrap align-items-center gap-2" hidden>
                    <span class="flex-grow-1">@Texts.ResumePick</span>
                    <button type="button" id="upload-pick-again" class="btn btn-sm btn-primary">@Texts.PickFiles</button>
                </div>
                @* Only while a .zip or .7z is among the files: ticks or unticks the box of each (which the list has), and shows a dash where
                   only some are ticked *@
                <div id="upload-unzip-field" class="mb-3" hidden>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="upload-unzip-all" checked aria-describedby="upload-unzip-hint"/>
                        <label class="form-check-label" for="upload-unzip-all">@Texts.UnzipArchives</label>
                    </div>
                    <div id="upload-unzip-hint" class="form-text">@Texts.UnzipArchivesHint</div>
                </div>
                <ul id="upload-list" class="list-group"></ul>
            </div>
            @* Below the list, which scrolls: how far it is, and what went wrong, stay in view *@
            <div class="upload-status-area">
                <div id="upload-progress" class="my-2" hidden>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="spinner-border spinner-border-sm text-secondary" aria-hidden="true"></span>
                        <span id="upload-status" class="small text-break"></span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="@Texts.Progress">
                        <div id="upload-bar" class="progress-bar" style="width: 0"></div>
                    </div>
                    <div id="upload-detail" class="small text-secondary mt-1" aria-live="polite"></div>
                </div>
                <div id="upload-error" class="alert alert-danger my-2" hidden></div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" id="upload-add-more" class="btn btn-outline-secondary" key="U">
                    <i class="fa-solid fa-plus"></i> @Texts.AddMore
                </button>
                <div class="d-flex gap-2">
                    <button type="button" id="upload-cancel" class="btn btn-secondary" key="Escape">@Texts.Cancel</button>
                    <button type="button" id="upload-confirm" class="btn btn-primary" key="Enter">
                        <i class="fa-solid fa-upload"></i> @Texts.Upload
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script-texts id="upload-texts" texts="@Texts"/>
<script component-asset="@_Upload.ChunksScript"></script>
<script component-asset="@_Upload.Script"></script>
