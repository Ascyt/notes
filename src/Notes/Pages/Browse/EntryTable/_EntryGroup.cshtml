@using Notes.Features.Components.Create
@using Notes.Features.HistoryViewing.Changes
@model _EntryGroup
@inject ListingTexts Texts

@* The parts of a cell follow each other without space between them (the box, the number, the icon), so their tags break between
   attributes rather than between tags *@
<table id="@(Model.Group)-group" class="table entry-table @(Model.IsLast ? "mb-0" : "")">
    @if (Model.Entries.Length > 0)
    {
        <thead>
        <tr>
            <th class="fw-normal small text-secondary">
                @if (Model.Listing.CanSelect)
                {
                    <input type="checkbox" class="form-check-input entry-select-all" data-group="@Model.Group" key="@Model.SelectAllKey"
                        aria-label="@(Model.IsDirectories ? Texts.SelectAllDirectories : Texts.SelectAllFiles)"/>
                }@(Model.IsDirectories ? Texts.Directories : Texts.Files)
            </th>
        </tr>
        </thead>
    }
    <tbody>
    @for (int i = 0; i < Model.Entries.Length; i++)
    {
        ListedEntry entry = Model.Entries[i];
        if (!entry.CanOpen)
        {
            <partial name="/Pages/Browse/EntryTable/_UnopenableEntry.cshtml" model="Model.UnopenableRow(entry, i)"/>
            continue;
        }
        string virtualPath = Model.Listing.ToVirtualPath(entry.Path);
        string name = Model.Listing.NameOf(entry.Path);
        @* A markdown file is shown by its title, with its file name as the tooltip, and in its place while Right Ctrl is held (key-held-text) *@
        string shownName = entry.DisplayName ?? name;
        bool isSelected = Model.Listing.IsSelected(virtualPath);
        @* The row can be selected by clicking anywhere on it but the link; Ctrl plus the shortcut of its link selects it as well *@
        <tr class="entry-row @(isSelected ? "table-active" : "")" data-group="@Model.Group" data-path="@virtualPath">
            <td>@if (Model.Listing.CanSelect)
                {<input type="checkbox" class="form-check-input entry-select" key="@Model.SelectKey(i)" aria-label="@Texts.Select(shownName)"
                    checked="@isSelected"/>}<span class="entry-index">@Model.Number(i)</span><i class="@Model.IconOf(entry)"></i>
                <a class="@_EntryGroup.LinkDecoration(entry)" href="@VirtualPaths.ToAddress(virtualPath)" key="@Model.OpenKey(i)"
                    key-anchor="i" title="@(entry.DisplayName is null ? null : name)"
                    key-held-text="@(entry.DisplayName is null ? null : name)">@shownName</a>@if (entry.IsUnlocked)
                {<partial name="/Features/Passwords/_UnlockedMark.cshtml"/>}@if (entry.Archived is { } archived)
                {<partial name="/Features/ZippedFolders/_ArchivedMark.cshtml" model="new Notes.Features.ZippedFolders._ArchivedMark
                    { State = archived, Encrypted = entry.ArchiveEncrypted, Progress = entry.ZipProgress,
                      Address = VirtualPaths.ToAddress(virtualPath) }"/>}@if (entry.UnzipProgress is not null || entry.UnzipError is not null)
                {<partial name="/Features/Components/Upload/_UnzipMark.cshtml" model="new Notes.Features.Components.Upload._UnzipMark
                    { Progress = entry.UnzipProgress, Error = entry.UnzipError, Name = name,
                      DirectoryAddress = VirtualPaths.ToAddress(Model.Listing.CanonicalVirtualPath) }"/>}@if (entry.Mark is { } mark)
                {<partial name="/Features/HistoryViewing/Changes/_ChangeMark.cshtml" model="new _ChangeMark { Mark = mark }"/>}</td>
        </tr>
    }
    @if (!Model.Listing.IsReadOnly)
    {
        <tr>
            <td>
                <partial name="/Features/Components/Create/_CreateButton.cshtml" model="new _CreateButton
                {
                    IsFile = !Model.IsDirectories,
                    DisabledReason = Model.Listing.CreateDeniedReason,
                    ShowsLabel = Model.Entries.Length == 0
                }"/>
            </td>
        </tr>
    }
    </tbody>
</table>
