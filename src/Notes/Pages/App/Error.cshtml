@page "/_/Error"
@model Notes.Pages.App.ErrorModel
@inject AppPageTexts Texts
@{
    Layout = NotesSetup.Layout;
    ViewData["Title"] = $"{Model.StatusCode} {Texts.ErrorName(Model.StatusCode)}";
}

<div class="py-4">
    <p class="display-1 fw-bold mb-0 @(Model.IsServerError ? "text-danger" : "text-secondary")">@Model.StatusCode</p>
    <h1 class="h3">@Texts.ErrorName(Model.StatusCode)</h1>
    <p class="lead">@Texts.ErrorDescription(Model.StatusCode)</p>

    @if (Model.MayNeedLogin)
    {
        <div class="alert alert-info d-flex gap-3 align-items-start" role="alert">
            <i class="fa-solid fa-circle-info mt-1"></i>
            <div>
                <p class="mb-2">@Texts.MayNeedLogin</p>
                <a class="btn btn-sm btn-primary" asp-page="/App/Login" asp-route-returnUrl="@Model.RequestedPath">
                    <i class="fa-solid fa-right-to-bracket"></i> @Texts.LogIn
                </a>
            </div>
        </div>
    }

    <div class="mt-4">
        <a class="btn btn-outline-secondary" href="/"><i class="fa-solid fa-house"></i> @Texts.BackToStart</a>
        @if (Model.IsServerError)
        {
            <a class="btn btn-outline-secondary" href="@Model.RequestedPath" key="r"><i class="fa-solid fa-rotate-right"></i> @Texts.TryAgain</a>
        }
    </div>

    <dl class="row small text-muted mt-5 mb-0">
        <dt class="col-sm-2">@Texts.Requested</dt>
        <dd class="col-sm-10"><code>@Model.RequestedPath</code></dd>
        <dt class="col-sm-2">@Texts.RequestId</dt>
        <dd class="col-sm-10"><code>@Model.RequestId</code></dd>
        <dt class="col-sm-2">@Texts.Time</dt>
        <dd class="col-sm-10">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
    </dl>
</div>
