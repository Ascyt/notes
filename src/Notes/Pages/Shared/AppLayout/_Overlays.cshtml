@using Notes.Extensions
@using Notes.Features.Auth
@using Notes.Features.Components.Busy
@using Notes.Features.Components.Toast
@inject Notes.Features.ZippedFolders.UnzipTexts UnzipTexts
@* What the pages of the app put over themselves, at the start of the body of every layout (docs/library.md): the stack of messages,
   the dialog that asks for the password of a locked entry, the notice of a session that ended, and for admins the dialog of the kill
   switch. It needs nothing of the page. *@

<partial name="/Features/Components/Toast/_Toasts.cshtml" model="new _Toasts()"/>
<partial name="/Features/Components/Busy/_BusyOverlay.cshtml" model="new _BusyOverlay()"/>
<partial name="/Features/Passwords/_PasswordModal.cshtml" model="new Notes.Features.Passwords._PasswordModal()"/>
@* Waits for an archived folder that a request needs to be unzipped (after the password dialog's script, which asks for passwords first) *@
<script-texts id="unzip-texts" texts="@UnzipTexts"/>
<script component-asset="@Notes.Features.ZippedFolders._Unzipping.Script"></script>
@if (User.IsInRole(AppAccess.AdminRole))
{
    <partial name="/Features/KillSwitch/_KillSwitchModal.cshtml" model="new Notes.Features.KillSwitch._KillSwitchModal()"/>
}
@if (SessionNotice.Of(Context) is { } sessionNotice)
{
    <partial name="/Features/Auth/_SessionNotice.cshtml"
        model='new _SessionNotice { Notice = sessionNotice, ReturnUrl = Context.OriginalPathAndQuery }'/>
}
