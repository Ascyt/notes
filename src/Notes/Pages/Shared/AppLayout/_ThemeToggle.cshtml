@inject LayoutTexts Texts
@* The button between the light and the dark theme (theme.js, which keeps the choice), for a layout that wants it (docs/library.md).
   Without it the theme follows the system's. It needs nothing of the page; its classes place it, and a layout may give it others. *@
<button id="theme-toggle" type="button" class="btn btn-sm btn-outline-secondary ms-auto ms-sm-2 me-2 me-sm-0 order-sm-last" key="!+A"
    data-label-light="@Texts.SwitchToDark" data-label-dark="@Texts.SwitchToLight">
    <i class="fa-solid fa-moon theme-icon-light"></i><i class="fa-solid fa-sun theme-icon-dark"></i>
</button>
