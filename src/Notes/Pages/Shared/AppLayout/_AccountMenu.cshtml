@using Notes.Extensions
@using Notes.Features.Auth
@inject Notes.Features.Passwords.PasswordUnlocks Unlocks
@* Logging in and out, who is logged in, and locking what is unlocked, for a layout that wants it (docs/library.md). It needs nothing of the page. *@
<partial name="/Features/Auth/_Account.cshtml" model='new _Account
{
    IsAuthenticated = User.Identity?.IsAuthenticated == true,
    IsAdmin = User.IsInRole(AppAccess.AdminRole),
    UserName = User.Identity?.Name ?? "",
    HasUnlocked = Unlocks.HasAnyUnlocked(Context),
    ReturnUrl = Context.OriginalPathAndQuery
}'/>
