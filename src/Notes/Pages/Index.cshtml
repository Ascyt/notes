@page "{**path:exposed}"
@using Notes.Extensions
@using Notes.Features.Auth
@inject Notes.Pages.Browse.ListingTexts ListingTexts
@model Notes.Pages.IndexModel
@inject Config Config
@{
    Layout = NotesSetup.Layout;
    ViewData["Title"] = Model.VirtualPath.NormalizedWith(Config.Title);
}

@* Whoever is not logged in may be seeing less than they could, and can't change anything. (After being logged out by the app the notice
   of that, with its login button, is already there.) *@
@if (User.Identity?.IsAuthenticated != true && (Model.Directory is { CanBrowse: true } || Model.File is not null
    || Model.FileChanges is not null) && SessionNotice.Of(Model.HttpContext) is null)
{
    <partial name="/Features/Auth/_LoginNotice.cshtml" model='new _LoginNotice { ReturnUrl = Model.HttpContext.OriginalPathAndQuery }'/>
}

@if (Model.PasswordPrompt is not null)
{
    <partial name="/Features/Passwords/_PasswordPrompt.cshtml" model="Model.PasswordPrompt"/>
}
else if (Model.ConfigEditor is not null)
{
    <partial name="/Pages/ConfigEditor/ConfigEditorView.cshtml" model="Model.ConfigEditor"/>
}
else if (Model.Directory is { CanBrowse: false })
{
    @* The root page, for someone who may not read the root: all there is for them is the way in *@
    if (User.Identity?.IsAuthenticated == true)
    {
        <p id="root-unreadable" class="text-muted">@ListingTexts.RootUnreadable</p>
    }
    else
    {
        string[] aroundLogin = ListingTexts.RootNeedsLogin.Split("{login}");
        <p id="root-unreadable" class="text-muted">@aroundLogin[0]<a asp-page="/App/Login" asp-route-returnUrl="/">@ListingTexts.LoginLink</a>@(aroundLogin.Length > 1 ? aroundLogin[1] : "")</p>
    }
}
else if (Model.Directory is not null)
{
    <partial name="/Pages/Browse/DirectoryView.cshtml" model="Model.Directory"/>
}
else if (Model.File is not null)
{
    <partial name="/Pages/Editor/FileView.cshtml" model="Model.File"/>
}
else if (Model.FileChanges is not null)
{
    <partial name="/Features/HistoryViewing/Changes/_FileChanges.cshtml" model="Model.FileChanges"/>
}

@if (Model.EarlierStateCard is not null)
{
    <partial name="/Features/HistoryViewing/Views/_EarlierStateCard.cshtml" model="Model.EarlierStateCard"/>
}

@* Why the page was sent here instead of to an earlier state (see EarlierStateNotice) *@
@if (Model.EarlierStateMessage is not null)
{
    <span id="earlier-state-message" hidden data-notify="@Model.EarlierStateMessage" data-notify-kind="danger"></span>
}
