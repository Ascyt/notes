<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The notes as a library: its pages, features, scripts and styles, for a site to use (see Notes.Host). Its files in wwwroot are served
         at _content/Notes/. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <!-- The packages that build the styles and scripts are no part of the project -->
        <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- The implicit usings of a web project (Microsoft.NET.Sdk.Web), which a Razor library doesn't get by itself -->
    <ItemGroup>
        <Using Include="System.Net.Http.Json" />
        <Using Include="Microsoft.AspNetCore.Builder" />
        <Using Include="Microsoft.AspNetCore.Hosting" />
        <Using Include="Microsoft.AspNetCore.Http" />
        <Using Include="Microsoft.AspNetCore.Routing" />
        <Using Include="Microsoft.Extensions.Configuration" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <!-- The styles and scripts of the components are written as SCSS and TypeScript (_Name.scss, _Name.ts) in their folders next to their
         views (Features/…, Pages/…) and built by npm (BuildClientAssets) into the _Name.css and _Name.js beside them, which are not kept
         in git. Those are served like the files of wwwroot: at _content/Notes/ and their path, such as
         _content/Notes/Features/Components/Toolbar/_Toolbar.css. (The SDK's own *.cshtml.css are scoped styles, which a site couldn't
         override, so these have names of their own.) -->
    <PropertyGroup>
        <ComponentAssetPatterns>Features/**/*.css;Features/**/*.js;Pages/**/*.css;Pages/**/*.js</ComponentAssetPatterns>
        <ComponentAssetExcluded>**/*.cshtml.css;**/*.cshtml.js;**/*.razor.css;**/*.razor.js</ComponentAssetExcluded>
    </PropertyGroup>

    <!-- The files that exist when the project is read (those of an earlier build) are kept out of the SDK's own items -->
    <ItemGroup>
        <ComponentAsset Include="$(ComponentAssetPatterns)" Exclude="$(ComponentAssetExcluded)" />
        <Content Remove="@(ComponentAsset)" />
        <None Remove="@(ComponentAsset)" />
    </ItemGroup>

    <ItemGroup>
        <ClientAssetSource Include="Features/**/*.scss;Pages/**/*.scss;Styles/**/*.scss;Features/**/*.ts;Pages/**/*.ts;Typings/**/*.ts" />
    </ItemGroup>

    <!-- The packages that build the styles and scripts, when package-lock.json says something other than what is installed -->
    <Target Name="RestoreClientTools" Inputs="package.json;package-lock.json" Outputs="node_modules/.package-lock.json">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

    <!-- Builds the CSS and JS of the components from their sources, when one of them changed. A type error in a script fails the build. -->
    <Target Name="BuildClientAssets" DependsOnTargets="RestoreClientTools" Inputs="@(ClientAssetSource);package.json;tsconfig.json;build-styles.mjs" Outputs="$(IntermediateOutputPath)client-assets.stamp">
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
        <Touch Files="$(IntermediateOutputPath)client-assets.stamp" AlwaysCreate="true" />
    </Target>

    <!-- The files are looked for again here, as a first build only now has them -->
    <Target Name="DefineComponentAssets" DependsOnTargets="BuildClientAssets" AfterTargets="ResolveProjectStaticWebAssets" Condition="'$(NoBuild)' != 'true'">
        <ItemGroup>
            <ComponentAsset Remove="@(ComponentAsset)" />
            <ComponentAsset Include="$(ComponentAssetPatterns)" Exclude="$(ComponentAssetExcluded)" />
        </ItemGroup>
        <DefineStaticWebAssets CandidateAssets="@(ComponentAsset)" RelativePathPattern="**" SourceType="Discovered" SourceId="$(PackageId)" ContentRoot="$(MSBuildProjectDirectory)\" BasePath="$(StaticWebAssetBasePath)" AssetMergeSource="$(StaticWebAssetMergeTarget)" FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
            <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
            <Output TaskParameter="Assets" ItemName="_ComponentStaticWebAsset" />
        </DefineStaticWebAssets>
        <DefineStaticWebAssetEndpoints CandidateAssets="@(_ComponentStaticWebAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
            <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>
    </Target>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
        <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
        <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
        <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.1" />
        <PackageReference Include="Markdig" Version="1.6.0" />
        <PackageReference Include="Markdown.ColorCode" Version="3.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Semver" Version="3.0.0" />
        <PackageReference Include="SharpCompress" Version="0.51.0-beta.174" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
    </ItemGroup>

</Project>
