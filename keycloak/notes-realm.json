{
  "realm": "notes",
  "displayName": "Notes",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "rememberMe": true,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Can browse, create, edit, rename and delete notes"
      }
    ]
  },
  "users": [
    {
      "username": "service-account-notes-web",
      "enabled": true,
      "serviceAccountClientId": "notes-web",
      "clientRoles": {
        "realm-management": ["manage-realm"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "notes-web",
      "name": "Notes",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${NOTES_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "https://${NOTES_HOST}/signin-oidc",
        "http://localhost:5243/signin-oidc",
        "https://localhost:7094/signin-oidc"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${NOTES_HOST}/signout-callback-oidc##http://localhost:5243/signout-callback-oidc##https://localhost:7094/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "realm roles (flat)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
